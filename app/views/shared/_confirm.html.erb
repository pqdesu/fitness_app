<%#
  The app's own "Are you sure?" box, used for every data-turbo-confirm instead of the browser's
  confirm(). confirm_dialog.js fills in the question and opens it; the page behind is tinted.
%>
<div class="modal fade confirm-modal" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-title" aria-describedby="confirm-detail" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <span class="confirm-icon" data-confirm-icon><i class="fa-solid fa-trash-can" aria-hidden="true"></i></span>
        <h2 class="confirm-title" id="confirm-title" data-confirm-title></h2>
        <p class="confirm-detail" id="confirm-detail" data-confirm-detail></p>
        <div class="confirm-actions">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" data-confirm-accept>Delete</button>
        </div>
      </div>
    </div>
  </div>
</div>
