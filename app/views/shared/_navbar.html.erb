<%# The top bar. On a phone a signed-in user gets the page's name here, after the logo, or after the
    back arrow on a sub-page (the arrow is drawn in <main> and placed over this bar on a phone, see
    .back-link in components/_layout); the sections are in the bottom bar (shared/_bottom_nav).
    There is no hamburger menu. %>
<% title = page_title if user_signed_in? %>
<% back = title && content_for?(:back) %>
<nav class="<%= class_names("navbar navbar-expand-md app-navbar sticky-top", "has-back": back) %>" aria-label="Main">
  <div class="container">
    <%= link_to root_path, class: class_names("navbar-brand", "d-none d-md-flex": back), aria: { label: "FitnessApp" } do %>
      <span class="brand-mark"><i class="fa-solid fa-dumbbell"></i></span>
      <span class="<%= "d-none d-md-inline" if title %>">FitnessApp</span>
    <% end %>
    <% if title %><span class="navbar-page-title d-md-none me-auto"><%= title %></span><% end %>

    <% if user_signed_in? %>
      <div class="navbar-collapse d-none d-md-flex">
        <ul class="navbar-nav me-auto">
          <% nav_sections.each do |label, path, _icon, active| %>
            <li class="nav-item"><%= nav_link_to label, path, active: %></li>
          <% end %>
        </ul>
        <ul class="navbar-nav">
          <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle user-chip" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="user-initial"><%= current_user.email.first.upcase %></span>
              <span class="user-email"><%= current_user.email %></span>
              <% if current_user.admin? %><span class="badge badge-soft">Admin</span><% end %>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
              <%= link_to "Account settings", edit_user_registration_path, class: "dropdown-item" %>
              <% if current_user.admin? %>
                <%= link_to "Users", admin_users_path, class: "dropdown-item" %>
                <%= link_to "Equipment", admin_equipment_items_path, class: "dropdown-item" %>
                <%= link_to "Set tags", admin_set_tags_path, class: "dropdown-item" %>
              <% end %>
              <div class="dropdown-divider"></div>
              <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
            </div>
          </li>
        </ul>
      </div>
    <% else %>
      <ul class="navbar-nav flex-row align-items-center gap-2">
        <li class="nav-item"><%= link_to "Log in", new_user_session_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary btn-sm" %></li>
      </ul>
    <% end %>
  </div>
</nav>
