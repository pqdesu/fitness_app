<%#
  Flash messages: a card that drops in at the top of the screen (flash_controller.js). A notice
  is green and leaves by itself after 5 seconds, waiting while it is pointed at or focused; an
  alert is red and stays until its × is pressed, so an error is not missed.
  data-turbo-temporary keeps them out of Turbo's page cache, so going back does not show
  an old message again.
%>
<% messages = { notice: notice, alert: alert }.compact_blank %>
<% if messages.any? %>
  <div class="flash-stack" data-turbo-temporary>
    <% messages.each do |kind, message| %>
      <% stays = kind == :alert %>
      <div class="flash flash-<%= kind %>" role="<%= stays ? "alert" : "status" %>"
           data-controller="flash" data-flash-delay-value="<%= stays ? 0 : 5000 %>"
           data-action="mouseenter->flash#pause mouseleave->flash#resume focusin->flash#pause focusout->flash#resume">
        <span class="flash-icon">
          <i class="fa-solid <%= kind == :alert ? "fa-circle-exclamation" : "fa-circle-check" %>"></i>
        </span>
        <p class="flash-text"><%= message %></p>
        <button type="button" class="flash-close" data-action="flash#dismiss" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <% unless stays %><span class="flash-timer" aria-hidden="true"></span><% end %>
      </div>
    <% end %>
  </div>
<% end %>
