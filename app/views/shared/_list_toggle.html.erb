<%#
  "Show …" / "Hide …": opens and closes a list that sits in a Bootstrap collapse, as the weekly
  overview's days. Locals: target (the collapse's id), label ("days", "exercises"), and optionally
  open (the collapse starts open: give it the "show" class too) and css (more classes).
%>
<% open = local_assigns.fetch(:open, false) %>
<button type="button" class="<%= class_names("toggle-days", local_assigns[:css]) %>" data-bs-toggle="collapse" data-bs-target="#<%= target %>"
        aria-expanded="<%= open %>" aria-controls="<%= target %>">
  <span class="toggle-days-label"><span class="when-closed">Show <%= label %></span><span class="when-open">Hide <%= label %></span></span>
  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
</button>
