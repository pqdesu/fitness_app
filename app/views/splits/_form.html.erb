<div class="card form-card">
  <div class="card-body">
    <%= simple_form_for split do |f| %>
      <%= f.input :name, placeholder: "e.g. Push / Pull / Legs", autofocus: true %>
      <div class="form-actions">
        <%= f.button :submit, (split.persisted? ? "Save split" : "Create split"), class: "btn-primary", data: { turbo_submits_with: "Saving…" } %>
        <%= link_to "Cancel", (split.persisted? ? split : splits_path), class: "btn btn-light" %>
      </div>
    <% end %>
  </div>
</div>
