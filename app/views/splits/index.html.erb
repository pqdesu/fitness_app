<div class="page-header">
  <div>
    <p class="eyebrow">Programs</p>
    <h1>Your splits</h1>
  </div>
  <%= link_to new_split_path, class: "btn btn-primary" do %><i class="fa-solid fa-plus"></i> New split<% end %>
</div>

<% if @splits.empty? %>
  <div class="card">
    <div class="empty-state">
      <i class="fa-solid fa-layer-group"></i>
      <p>You have no splits yet. A split is your training program, made of workout days.</p>
      <%= link_to "Create your first split", new_split_path, class: "btn btn-primary" %>
    </div>
  </div>
<% else %>
  <div class="row g-3">
    <% @splits.each do |split| %>
      <div class="col-md-6 col-lg-4">
        <%= link_to split, class: "card card-link" do %>
          <div class="card-body">
            <h2><%= split.name %></h2>
            <p class="text-muted small"><%= pluralize(split.workout_days.size, "workout day") %></p>
            <div class="chip-row">
              <% split.workout_days.sort_by { |d| [d.order_index, d.id] }.each do |day| %>
                <span class="chip"><%= day.day %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
