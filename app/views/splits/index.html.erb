<% back_to root_path if from_dashboard? %>
<div class="page-header">
  <div>
    <h1>Your splits</h1>
    <% if @splits.size > 1 %><p class="text-muted small mb-0">The active split is the one your dashboard follows.</p><% end %>
  </div>
  <%= link_to new_split_path, class: "btn btn-primary" do %><i class="fa-solid fa-plus" aria-hidden="true"></i> New split<% end %>
</div>

<% if @splits.empty? %>
  <div class="card"><%= render "empty" %></div>
<% else %>
  <div class="row g-3">
    <% @splits.each do |split| %>
      <div class="col-md-6 col-lg-4">
        <% active = split == @active_split %>
        <div class="<%= class_names("card card-link split-card", "is-active": active) %>">
          <div class="card-body">
            <% if active %><span class="badge badge-soft split-active-badge"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Active</span><% end %>
            <h2><%= link_to split.name, split, class: "stretched-link" %></h2>
            <p class="text-muted small"><%= pluralize(split.workout_days.size, "workout day") %></p>
            <div class="chip-row">
              <% split.workout_days.sort_by { |d| [d.weekday, d.id] }.each do |day| %>
                <span class="chip"><%= day.day %></span>
              <% end %>
            </div>
            <% unless active %>
              <%= button_to "Set as active", activate_split_path(split, from: ("dashboard" if from_dashboard?)), method: :patch,
                    class: "btn btn-light btn-sm", form: { class: "split-activate" } %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
