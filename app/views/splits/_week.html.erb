<%#
  The week of a split, Sunday to Saturday. A weekday with a workout day is coloured: on the dashboard
  (with plan) it opens that workout, on the split page it goes to that day's plan below. An empty
  weekday is blank and starts a new workout day on it. Locals: split, workout_days,
  optionally today (a weekday number, 0 = Sunday) to ring that day, and optionally plan
  (weekday => workout day, from Split#week_plan) to show one week with its moved workouts: a moved
  workout is drawn dashed on its new day, and the day it left is blank and opens the split.
  Optionally states (weekday => :missed or :extra, from Dashboard#week_states, on the dashboard
  and the Today page): a planned day that passed with nothing logged is dotted, a workout off the
  plan is a light ring. Without it (the split page) the strip is only the plan.
%>
<% days_by_weekday = local_assigns[:plan] || workout_days.index_by(&:weekday) %>
<% planned_weekdays = workout_days.map(&:weekday) %>
<% today = local_assigns[:today] %>
<% states = local_assigns.fetch(:states, {}) %>
<div class="week">
  <% Date::DAYNAMES.each_with_index do |weekday_name, weekday| %>
    <% day = days_by_weekday[weekday] %>
    <% moved = day && day.weekday != weekday %>
    <% left = day.nil? && planned_weekdays.include?(weekday) %>
    <% href = if day then local_assigns[:plan] ? workout_day_path(day) : split_path(split, anchor: "day-#{day.id}")
              elsif left then split_path(split)
              else new_split_workout_day_path(split, weekday:) end %>
    <% label = if moved then "#{weekday_name}: #{day.day}, moved from #{day.weekday_name} this week"
               elsif day then "#{weekday_name}: #{day.day}"
               elsif left then "#{weekday_name}: no workout this week, it was moved"
               else "#{weekday_name}: add a workout day" end %>
    <% label += ", missed. Add it." if states[weekday] == :missed %>
    <% label += ", trained off the plan" if states[weekday] == :extra %>
    <%= link_to href,
          class: class_names("week-day", "is-set": day, "is-moved": moved, "is-today": weekday == today,
                             "is-missed": states[weekday] == :missed, "is-extra": states[weekday] == :extra),
          "aria-current": ("date" if weekday == today), "aria-label": label, title: label do %>
      <span class="week-circle"><%= weekday_name.first %></span>
      <span class="week-label"><%= day&.day %></span>
    <% end %>
  <% end %>
</div>
