<%# Moving or removing a planned exercise comes back here: Turbo morphs the page in place, keeping
    the scroll and each day card open or folded as it was (fold_controller.js). %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% back_to splits_path %>
<div class="page-header">
  <div>
    <h1><%= @split.name %></h1>
  </div>
  <div class="header-actions">
    <% if @split.active? %>
      <span class="badge badge-soft split-active-badge align-self-center"><i class="fa-solid fa-circle-check"></i> Active split</span>
    <% else %>
      <%= button_to "Set as active", activate_split_path(@split), method: :patch, class: "btn btn-primary" %>
    <% end %>
    <%= actions_menu @split.name do %>
      <%= menu_link "Rename", edit_split_path(@split) %>
      <%= menu_delete "Delete split", @split, confirm: "Delete this split and its days? Your logged workouts are kept." %>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Your week</h2></div>
  <div class="card-body">
    <%= render "week", split: @split, workout_days: @workout_days %>
    <p class="text-muted small text-center mb-0 mt-3">Tap an empty day to add a workout, then plan its exercises below.</p>
  </div>
</div>

<%# The plan of each workout day: only which exercises. Sets are added when the workout is trained.
    Each day is folded but today's: its arrow, its circle in the week above, or an address ending in
    #day-<id> (where planning returns) opens it (fold_controller.js). %>
<% @workout_days.each do |day| %>
  <% planned = day.workout_exercises.to_a %>
  <% open = day.weekday == Date.current.wday %>
  <% panel_id = "day-#{day.id}-plan" %>
  <div class="card day-plan mt-3" id="day-<%= day.id %>" data-controller="fold"
       data-action="click@document->fold#openFromLink turbo:before-morph-attribute->fold#keep">
    <div class="card-header">
      <div>
        <h2><%= day.day %></h2>
        <p class="text-muted small mb-0"><%= day.weekday_name %><% if open %> · Today<% end %></p>
      </div>
      <div class="entry-meta">
        <span class="chip"><%= pluralize(planned.size, "exercise") %></span>
        <%= actions_menu day.day do %>
          <%= menu_link "Edit", edit_workout_day_path(day) %>
          <%= menu_delete "Delete #{day.day}", workout_day_path(day), confirm: "Delete #{day.day} and its planned exercises? Your logged workouts are kept." %>
        <% end %>
        <button type="button" class="btn btn-light btn-sm fold-toggle" data-bs-toggle="collapse" data-bs-target="#<%= panel_id %>"
                aria-expanded="<%= open %>" aria-controls="<%= panel_id %>" aria-label="Exercises of <%= day.day %>" data-fold-target="toggle">
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="<%= class_names("collapse", show: open) %>" id="<%= panel_id %>" data-fold-target="panel">
      <% if planned.any? %>
        <ul class="list-rows">
          <% planned.each_with_index do |we, i| %>
            <li class="<%= class_names("just-moved": flash[:moved] == we.id) %>">
              <div>
                <span class="row-title"><%= we.name %></span>
                <% if we.exercise&.muscle_group.present? %><span class="text-muted small"><%= we.exercise.muscle_group %></span><% end %>
              </div>
              <%# Reorders the plan; the workout day's page follows this order. %>
              <span class="move-buttons">
                <% { "up" => i.positive?, "down" => i < planned.size - 1 }.each do |direction, shown| %>
                  <% if shown %>
                    <%= button_to move_workout_exercise_path(we, direction:), method: :patch, class: "btn btn-link btn-sm",
                          "aria-label": "Move #{we.name} #{direction}", title: "Move #{we.name} #{direction}" do %><%= icon_tag "arrow-#{direction}" %><% end %>
                  <% else %>
                    <span class="move-spacer"></span>
                  <% end %>
                <% end %>
              </span>
              <%= button_to workout_exercise_path(we), method: :delete, class: "btn btn-link btn-sm text-danger",
                    "aria-label": "Remove #{we.name} from #{day.day}", title: "Remove #{we.name} from #{day.day}" do %><i class="fa-solid fa-xmark"></i><% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="empty-state compact"><p>No exercises planned yet.</p></div>
      <% end %>
      <div class="card-footer d-grid">
        <%= exercise_picker_button "btn-light", key: day.id, label: "Plan exercises" %>
      </div>
    </div>
  </div>
  <%= render "shared/exercise_picker", url: workout_day_workout_exercises_path(day), exercises: picker_exercises,
        taken_ids: planned.filter_map(&:exercise_id), key: day.id %>
<% end %>
