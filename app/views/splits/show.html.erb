<div class="page-header">
  <div>
    <p class="eyebrow"><%= link_to "Splits", splits_path %></p>
    <h1><%= @split.name %></h1>
  </div>
  <div class="header-actions">
    <%= link_to new_split_workout_day_path(@split), class: "btn btn-primary" do %><i class="fa-solid fa-plus"></i> Add workout day<% end %>
    <%= link_to "Rename", edit_split_path(@split), class: "btn btn-light" %>
    <%= button_to "Delete", @split, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this split with all its days and logged workouts?" } } %>
  </div>
</div>

<% if @workout_days.empty? %>
  <div class="card">
    <div class="empty-state">
      <i class="fa-solid fa-calendar-day"></i>
      <p>This split has no workout days yet, for example “Push”, “Pull” and “Legs”.</p>
      <%= link_to "Add the first workout day", new_split_workout_day_path(@split), class: "btn btn-primary" %>
    </div>
  </div>
<% else %>
  <div class="row g-3">
    <% @workout_days.each do |day| %>
      <div class="col-md-6 col-lg-4">
        <%= link_to day, class: "card card-link" do %>
          <div class="card-body">
            <span class="order-badge"><%= day.order_index %></span>
            <h2><%= day.day %></h2>
            <% if day.workout_exercises.empty? %>
              <p class="text-muted small mb-0">No exercises planned yet</p>
            <% else %>
              <ul class="plain-list">
                <% day.workout_exercises.sort_by(&:id).each do |we| %>
                  <li><span><%= we.exercise.name %></span><span class="text-muted"><%= we.sets %> × <%= we.reps %></span></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
