<% back_to "Splits", splits_path %>
<div class="page-header">
  <div>
    <h1><%= @split.name %></h1>
  </div>
  <div class="header-actions">
    <% if @split.active? %>
      <span class="badge badge-soft split-active-badge align-self-center"><i class="fa-solid fa-circle-check"></i> Active split</span>
    <% else %>
      <%= button_to "Set as active", activate_split_path(@split), method: :patch, class: "btn btn-primary" %>
    <% end %>
    <%= link_to "Rename", edit_split_path(@split), class: "btn btn-light" %>
    <%= button_to "Delete", @split, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this split and its days? Your logged workouts are kept." } } %>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Your week</h2></div>
  <div class="card-body">
    <%= render "week", split: @split, workout_days: @workout_days %>
    <p class="text-muted small text-center mb-0 mt-3">Tap a coloured day to open its workout, or an empty day to add one.</p>
  </div>
</div>
