<% back_to "Splits", splits_path %>
<div class="page-header">
  <div>
    <h1><%= @split.name %></h1>
  </div>
  <div class="header-actions">
    <%= link_to "Rename", edit_split_path(@split), class: "btn btn-light" %>
    <%= button_to "Delete", @split, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this split with all its days and logged workouts?" } } %>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Your week</h2></div>
  <div class="card-body">
    <%= render "week", split: @split, workout_days: @workout_days %>
    <p class="text-muted small text-center mb-0 mt-3">Tap a coloured day to open its workout, or an empty day to add one.</p>
  </div>
</div>

<% unscheduled = @workout_days.select { |day| day.weekday.nil? } %>
<% if unscheduled.any? %>
  <div class="card">
    <div class="card-header"><h2>Not on a weekday yet</h2></div>
    <ul class="list-rows">
      <% unscheduled.each do |day| %>
        <li>
          <%= link_to day.day, workout_day_path(day), class: "row-title" %>
          <%= link_to "Choose a weekday", edit_workout_day_path(day), class: "btn btn-light btn-sm" %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
