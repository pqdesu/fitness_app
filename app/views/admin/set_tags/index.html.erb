<% back_to edit_user_registration_path %>
<div class="page-header">
  <div>
    <h1>Set tags</h1>
    <p class="text-muted mb-0">What users can mark a set with, such as a warm-up or an assisted set. Deleting a tag takes it off every set that has it.</p>
  </div>
</div>

<%# On a phone the form to add comes first, above the list; beside it from lg up. %>
<div class="row g-3">
  <div class="col-lg-4 order-lg-2">
    <div class="card">
      <div class="card-header"><h2>Add a tag</h2></div>
      <div class="card-body"><%= render "form", tag: @tag, submit: "Add" %></div>
    </div>
  </div>

  <div class="col-lg-8 order-lg-1">
    <div class="card" id="set-tags">
      <div class="card-header"><h2>Tags</h2><span class="chip"><%= @tags.size %></span></div>
      <% if @tags.empty? %>
        <div class="empty-state compact"><p>None yet.</p></div>
      <% else %>
        <ul class="list-rows">
          <% @tags.each do |tag| %>
            <li>
              <span class="row-title"><%= tag.name %></span>
              <%= actions_menu tag.name do %>
                <%= menu_link "Edit", edit_admin_set_tag_path(tag) %>
                <%= menu_delete "Delete", admin_set_tag_path(tag), confirm: "Delete #{tag.name}? It is taken off every set that has it." %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</div>
