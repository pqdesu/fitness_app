<%# The name of a set tag. Locals: tag, submit. %>
<%= form_with model: [:admin, tag], class: "inline-form" do |f| %>
  <% if tag.errors.any? %><div class="alert alert-danger"><%= errors_of(tag) %>.</div><% end %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, placeholder: "Warm-up", autocomplete: "off", required: true, maxlength: 30, class: "form-control" %>
  </div>
  <%= f.submit submit, class: "btn btn-primary" %>
<% end %>
