<%# Name and kind of a catalogue item. Locals: item, submit. %>
<%= form_with model: [:admin, item], class: "inline-form" do |f| %>
  <% if item.errors.any? %><div class="alert alert-danger"><%= errors_of(item) %>.</div><% end %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, placeholder: "e.g. Dumbbell", autocomplete: "off", required: true, maxlength: 60, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= render "shared/choices", f:, field: :kind, label: "Kind", selected: item.kind, id: "equipment_item_#{item.id}_kind",
          choices: EquipmentItem::KINDS.invert.to_a %>
  </div>
  <%= f.submit submit, class: "btn btn-primary" %>
<% end %>
