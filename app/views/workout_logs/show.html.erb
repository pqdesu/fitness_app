<%# Saving a set or its note comes back to this same page: Turbo morphs it in place and keeps the scroll, so it does not jump. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% if from_dashboard? %>
  <% back_to root_path %>
<% elsif @workout_day %>
  <% back_to workout_day_path(@workout_day, date: @workout_log.date) %>
<% else %>
  <% back_to workout_logs_path %>
<% end %>
<div class="page-header">
  <div>
    <h1><%= @workout_log.workout %> workout</h1>
    <p class="text-muted mb-0"><%= l @workout_log.date, format: :long %><% if @workout_log.rest_day? %> <span class="chip chip-rest">Rest day, trained anyway</span><% end %></p>
  </div>
  <div class="header-actions">
    <%= button_to "Delete workout", workout_log_path(@workout_log, from: ("dashboard" if from_dashboard?)), method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this workout and all its sets?" } } %>
  </div>
</div>

<%# A Cardio workout has no workout timer: each cardio exercise has its own (cardio_entries/_timer). %>
<% cardio_workout = @workout_log.workout == WorkoutLog::CARDIO %>
<% unless cardio_workout %>
  <%= render "workout_logs/timer", log: @workout_log, start_path: (workout_log_timer_path(@workout_log) if @workout_log.timer_today?),
        autostart: current_user.timer_auto_start? %>
<% end %>
<%# Before the paused-timer alert, so it asks first and each asks once (rest_alert_controller.js). %>
<%= render "workout_sets/rest_alert" %>
<%= render "workout_logs/timer_alert", log: @workout_log, leave: true unless cardio_workout %>

<div class="row g-4">
  <%# Its exercises and sets are this workout: their links are not leaving it (workout_logs/_timer_alert). %>
  <div class="col-lg-8" data-stays-in-workout>
    <% if @log_exercises.empty? %>
      <div class="card">
        <div class="empty-state">
          <i class="fa-solid fa-dumbbell"></i>
          <p>This workout has no exercises yet. Add the first one below.</p>
        </div>
      </div>
    <% end %>

    <%# Reordered by dragging a card by its handle (sortable_controller.js), or Move up / Move down in its ⋯ menu. %>
    <div class="entry-list" data-controller="sortable">
    <% @log_exercises.each_with_index do |entry, i| %>
      <% sets = entry.workout_sets.sort_by(&:set_number) %>
      <% top = entry.top_set %>
      <%# Cardio is logged as incline, speed and time: no sets, equipment or rest timer (it has its own timer). %>
      <% cardio = entry.cardio? %>
      <% panel_id = "entry-#{entry.id}-sets" %>
      <%# A Cardio workout opens its first exercise, and a cardio exercise whose timer has started is open: that is where its timer is. %>
      <% open = cardio && ((cardio_workout && i.zero?) || entry.rest_started_at.present?) %>
      <%# Each exercise starts folded: its name, sets and heaviest set; the arrow opens its sets and
          the add-set form (fold_controller.js keeps it open when a save refreshes the page). %>
      <div class="<%= class_names("card entry-card", "just-moved": flash[:moved] == entry.id) %>" id="entry-<%= entry.id %>" data-sortable-url="<%= move_workout_log_exercise_path(entry) %>" data-controller="fold" data-action="turbo:before-morph-attribute->fold#keep">
        <div class="card-header">
          <span class="drag-handle" title="Drag to reorder" aria-hidden="true"><%= icon_tag "grip-vertical" %></span>
          <div>
            <h2><%= entry.name %></h2>
            <p class="text-muted small mb-0"><%= entry.equipment_label %><% if entry.exercise&.unilateral? %> · Unilateral<% end %><% if top %>&nbsp;· <span class="text-nowrap">Top <span class="top-set"><%= weight_and_reps(top) %></span></span><% end %> <span class="chip"><%= entry_done(entry) %></span></p>
            <% if entry.notes.present? %><p class="entry-note small mb-0"><i class="fa-regular fa-note-sticky"></i> <%= entry.notes %></p><% end %>
          </div>
          <div class="entry-meta">
            <%= actions_menu entry.name do %>
              <%= menu_link "Edit", edit_workout_log_exercise_path(entry) %>
              <% if i.positive? %><%= menu_button "Move up", move_workout_log_exercise_path(entry, to: "up"), icon: "arrow-up" %><% end %>
              <% if i < @log_exercises.size - 1 %><%= menu_button "Move down", move_workout_log_exercise_path(entry, to: "down"), icon: "arrow-down" %><% end %>
              <%= menu_delete "Remove from workout", workout_log_exercise_path(entry), confirm: "Remove #{entry.name} and its sets from this workout?" %>
            <% end %>
            <button type="button" class="btn btn-link btn-sm entry-toggle fold-toggle" data-bs-toggle="collapse" data-bs-target="#<%= panel_id %>"
                    aria-expanded="<%= open %>" aria-controls="<%= panel_id %>" aria-label="Sets of <%= entry.name %>" data-fold-target="toggle">
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="<%= class_names("collapse", show: open) %>" id="<%= panel_id %>" data-fold-target="panel">
          <% if cardio %>
            <% if entry.cardio_entries.any? %><%= render "cardio_entries/table", cardio_entries: entry.cardio_entries %><% end %>
            <div class="card-footer">
              <%= render "cardio_entries/timer", entry:, date: @workout_log.date, back: {} %>
              <%= render "cardio_entries/form", parent: entry, last: entry.cardio_entries.last, entry: %>
            </div>
          <% else %>
            <% if sets.any? %>
              <%= render "workout_sets/table", sets: sets %>
            <% end %>

            <div class="card-footer">
              <%= render "workout_sets/rest_timer", entry: %>
              <%= render "workout_sets/form", parent: entry, last_set: sets.last, first: sets.empty?, rest_entry: entry %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    </div>

    <% if @unlogged_exercises.any? %>
      <div class="card">
        <div class="card-header"><h2>From this day, not in this workout</h2></div>
        <ul class="list-rows">
          <% @unlogged_exercises.each do |we| %>
            <li>
              <span class="row-title"><%= we.name %></span>
              <%= button_to "Add", workout_log_workout_log_exercises_path(@workout_log), params: { workout_exercise_id: we.id }, class: "btn btn-light btn-sm",
                    form: { data: { alert_when_paused: "add" } } %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="d-grid mt-3">
      <%= exercise_picker_button "btn-light" %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card log-details">
      <div class="card-header"><h2>Details</h2></div>
      <div class="card-body">
        <%= form_with model: @workout_log do |f| %>
          <div class="mb-3">
            <%= f.label :date, class: "form-label" %>
            <%= f.date_field :date, class: "form-control", min: WorkoutLog::EARLIEST_DATE, max: Date.current %>
          </div>
          <div class="mb-3">
            <%= f.label :notes, class: "form-label" %>
            <%= f.text_area :notes, rows: 4, placeholder: "How did it go?", class: "form-control" %>
          </div>
          <%= f.submit "Save details", class: "btn btn-light w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render "shared/exercise_picker", url: workout_log_workout_log_exercises_path(@workout_log),
      exercises: picker_exercises, taken_ids: @log_exercises.filter_map(&:exercise_id), cardio: @workout_log.workout == WorkoutLog::CARDIO %>
