<%# With a date (a calendar day with several workouts) this is a sub-page: the workouts of that day. %>
<% from = ("dashboard" if from_dashboard?) %>
<% if @date %>
  <% from ? back_to(root_path) : back_to(workout_logs_path) %>
<% end %>
<div class="page-header">
  <div>
    <p class="eyebrow">History</p>
    <h1><%= @date ? "Workouts on #{l @date, format: :long}" : "Logged workouts" %></h1>
  </div>
</div>

<div class="card">
  <% if @workout_logs.empty? && @date %>
    <div class="empty-state">
      <i class="fa-solid fa-clipboard-list"></i>
      <p>No workouts were logged on this day.</p>
      <%= link_to "All logged workouts", workout_logs_path, class: "btn btn-primary" %>
    </div>
  <% elsif @workout_logs.empty? %>
    <div class="empty-state">
      <i class="fa-solid fa-clipboard-list"></i>
      <p>No workouts logged yet. Open a workout day in one of your splits, open an exercise and add your first set.</p>
      <%= link_to "Go to splits", splits_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <%# On a phone the date, workout, split and counts share one cell (.history-summary); from md up each has its column. %>
    <% wide = "d-none d-md-table-cell" %>
    <div class="table-responsive">
      <table class="table app-table history-table">
        <thead>
          <tr>
            <th class="d-md-none">Workout</th>
            <th class="<%= wide %>">Date</th><th class="<%= wide %>">Workout</th><th class="<%= wide %>">Split</th>
            <th class="<%= wide %>">Exercises</th><th class="<%= wide %>">Sets</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% @workout_logs.each do |log| %>
            <% path = workout_log_path(log, from: from) %>
            <% exercises = log.workout_log_exercises.size %>
            <% sets = log.workout_log_exercises.sum { |e| e.workout_sets.size } %>
            <% cardio = WorkoutSummary.new(log).cardio_seconds %>
            <% rest_chip = capture do %><% if log.rest_day? %> <span class="chip chip-rest">Rest day</span><% end %><% end %>
            <%# The timer's line, with a pen to correct when it finished (a timer left running too long). %>
            <% timer_pen = capture do %><% if log.started_at %><%= link_to edit_workout_log_timer_path(log), class: "timer-edit",
                  "aria-label": "Edit the timer of #{log.workout} on #{l log.date, format: :long}", title: "Edit timer" do %><i class="fa-solid fa-pen"></i><% end %><% end %><% end %>
            <% split_chip = capture do %><% if log.workout_day %><span class="chip" title="<%= log.workout_day.split.name %>"><%= log.workout_day.split.name %></span><% else %><span class="text-muted small">Deleted</span><% end %><% end %>
            <tr>
              <td class="history-summary d-md-none">
                <%= link_to l(log.date, format: :long), path, class: "fw-semibold" %>
                <div class="history-line"><%= log.workout %><%= rest_chip %> <%= split_chip %></div>
                <div class="history-counts"><%= pluralize(exercises, "exercise") %> · <%= sets_and_time(sets, cardio) %></div>
                <% if (time = workout_time(log)) %><div class="history-counts history-time"><i class="fa-regular fa-clock" aria-hidden="true"></i><span class="history-time-text"><%= time %></span><%= timer_pen %></div><% end %>
              </td>
              <td class="fw-semibold <%= wide %>"><%= link_to l(log.date, format: :long), path %><% if (time = workout_time(log)) %><div class="history-counts history-time fw-normal"><span class="history-time-text"><%= time %></span><%= timer_pen %></div><% end %></td>
              <td class="<%= wide %>"><%= log.workout %><%= rest_chip %></td>
              <td class="<%= wide %>"><%= split_chip %></td>
              <td class="<%= wide %>"><%= exercises %></td>
              <td class="<%= wide %>"><%= sets %><% if cardio.positive? %> · <%= duration_text(cardio) %><% end %></td>
              <td class="text-end"><%= link_to "Open", path, class: "btn btn-light btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination" %>
  <% end %>
</div>
