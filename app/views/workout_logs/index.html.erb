<%# With a date (a calendar day with several workouts) this is a sub-page: the workouts of that day. %>
<% from = ("dashboard" if params[:from] == "dashboard") %>
<% if @date %>
  <% from ? back_to("Dashboard", root_path) : back_to("History", workout_logs_path) %>
<% end %>
<div class="page-header">
  <div>
    <p class="eyebrow">History</p>
    <h1><%= @date ? "Workouts on #{l @date, format: :long}" : "Logged workouts" %></h1>
  </div>
</div>

<div class="card">
  <% if @workout_logs.empty? && @date %>
    <div class="empty-state">
      <i class="fa-solid fa-clipboard-list"></i>
      <p>No workouts were logged on this day.</p>
      <%= link_to "All logged workouts", workout_logs_path, class: "btn btn-primary" %>
    </div>
  <% elsif @workout_logs.empty? %>
    <div class="empty-state">
      <i class="fa-solid fa-clipboard-list"></i>
      <p>No workouts logged yet. Open a workout day in one of your splits, open an exercise and add your first set.</p>
      <%= link_to "Go to splits", splits_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <div class="table-responsive">
      <table class="table app-table">
        <thead><tr><th>Date</th><th>Workout</th><th>Split</th><th>Exercises</th><th>Sets</th><th></th></tr></thead>
        <tbody>
          <% @workout_logs.each do |log| %>
            <tr>
              <td class="fw-semibold"><%= link_to l(log.date, format: :long), workout_log_path(log, from: from) %></td>
              <td><%= log.workout %></td>
              <td><% if log.workout_day %><span class="chip"><%= log.workout_day.split.name %></span><% else %><span class="text-muted small">Deleted</span><% end %></td>
              <td><%= log.workout_log_exercises.size %></td>
              <td><%= log.workout_log_exercises.sum { |e| e.workout_sets.size } %></td>
              <td class="text-end"><%= link_to "Open", workout_log_path(log, from: from), class: "btn btn-light btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination" %>
  <% end %>
</div>
