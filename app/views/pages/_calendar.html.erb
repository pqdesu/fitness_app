<%#
  The month of `today`, with this week's row and today marked. A day is highlighted only when a
  workout was logged on it, and then it is a link to what was recorded: the workout itself, or the
  day's list in History when there were several. Locals: today, weeks (the month, as weeks of
  seven dates), logs_by_date (date => workout logs).
%>
<div class="card calendar-card">
  <div class="card-header"><h2><%= l today, format: "%B %Y" %></h2></div>
  <div class="card-body">
    <div class="calendar" role="table" aria-label="<%= l today, format: "%B %Y" %>">
      <div class="calendar-week calendar-head" role="row">
        <% Date::DAYNAMES.each do |name| %><span role="columnheader" aria-label="<%= name %>"><%= name.first %></span><% end %>
      </div>
      <% weeks.each do |week| %>
        <div class="<%= class_names("calendar-week", "is-current-week": week.include?(today)) %>" role="row">
          <% week.each do |date| %>
            <% logs = logs_by_date.fetch(date, []) %>
            <% classes = class_names("calendar-day", "is-today": date == today, "is-outside": date.month != today.month, "has-workout": logs.any?) %>
            <% current = ("date" if date == today) %>
            <%# A table, read cell by cell; a logged day keeps its link inside its cell, so it is still announced as a link. %>
            <div role="cell">
              <% if logs.any? %>
                <% workouts = "#{logs.map(&:workout).to_sentence} #{'workout'.pluralize(logs.size)}" %>
                <%= link_to date.day, day_logs_path(logs, date),
                      class: classes, "aria-current": current,
                      title: workouts, "aria-label": "#{l date, format: '%A, %B %-d'}: #{workouts}" %>
              <% else %>
                <%= tag.span date.day, class: classes, "aria-current": current %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
