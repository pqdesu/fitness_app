<%# The Home page ("/", pages#home), what was the Today page and the dashboard in one: today's
    workout (or on a rest day the choices, folded), the active split's week with its moves,
    the month's calendar and recent workouts. On a phone they stack in that order; from desktop
    width the calendar takes the left column.
    Moving a workout (or Back to the plan) comes back here and keeps the scroll. The page is replaced,
    not morphed, so the Move pop-up's Bootstrap state never outlives it. %>
<% turbo_refreshes_with method: :replace, scroll: :preserve %>
<% dashboard = @dashboard %>
<% split = dashboard.split %>
<% today = dashboard.today %>
<div class="page-header">
  <div>
    <p class="eyebrow">Today</p>
    <h1><%= l today, format: "%A, %B %-d" %></h1>
  </div>
  <%# The phone's bottom bar has no Exercises tab; the catalogue is reached from here. %>
  <%= link_to exercises_path, class: "btn btn-light btn-sm d-md-none" do %><i class="fa-solid fa-dumbbell"></i> Exercises<% end %>
</div>

<div class="row g-4">
  <div class="col-lg-7 order-lg-2">
    <% if split %>
      <%= render "today_box", dashboard: dashboard, dated: false %>
    <% end %>

    <div class="card split-card is-active h-auto">
      <% if split %>
        <div class="card-header">
          <div>
            <p class="eyebrow">Active split</p>
            <h2><%= link_to split.name, split, class: "row-title" %></h2>
          </div>
          <% if dashboard.several_splits? %><%= link_to "Change", splits_path(from: "dashboard"), class: "link-quiet" %><% end %>
        </div>
        <div class="card-body">
          <%= render "splits/week", split: split, workout_days: dashboard.days, plan: dashboard.week_plan, states: dashboard.week_states, today: today.wday %>
          <%= render "week_moves", dashboard: dashboard, split: split %>
          <%= render "week_overview", dates: dashboard.week_dates, logs_by_date: dashboard.week_logs, summary: dashboard.week_summary, today: today %>
        </div>
      <% else %>
        <div class="card-header"><h2>Active split</h2></div>
        <%= render "splits/empty" %>
      <% end %>
    </div>
  </div>

  <div class="col-lg-5 order-lg-1">
    <%= render "calendar", today: today, weeks: dashboard.calendar_weeks, logs_by_date: dashboard.calendar_logs, states: dashboard.calendar_states, day_states: dashboard.day_states %>
  </div>

  <%# Under the right column from desktop width, after the calendar on a phone. %>
  <div class="col-lg-7 offset-lg-5 order-lg-3">
    <div class="card">
      <div class="card-header"><h2>Recent workouts</h2><%= link_to "History", workout_logs_path, class: "link-quiet" %></div>
      <% if dashboard.recent_logs.empty? %>
        <div class="empty-state">
          <i class="fa-solid fa-clipboard-list"></i>
          <p>No workouts logged yet. Open a workout day, open an exercise and add your first set.</p>
        </div>
      <% else %>
        <ul class="recent-list">
          <%= render partial: "recent_workout", collection: dashboard.recent_logs, as: :log %>
        </ul>
      <% end %>
    </div>
  </div>
</div>

<%= render "today_popups", dashboard: dashboard, split: split %>
