<%# The heaviest set of each exercise of a logged workout. Locals: lifts (logged exercises), list_class. %>
<ul class="list-rows <%= list_class %>">
  <% lifts.sort_by(&:id).each do |lift| %>
    <% top = lift.top_set %>
    <li>
      <span class="row-title"><%= lift.name %></span>
      <span class="top-set">
        <% if top %><%= format_weight(top.weight_used) %> × <%= pluralize(top.reps_completed, "rep") %><% else %><span class="text-muted">No sets</span><% end %>
      </span>
    </li>
  <% end %>
</ul>
