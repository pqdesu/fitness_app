<% if user_signed_in? %>
  <div class="page-header">
    <div>
      <p class="eyebrow">Dashboard</p>
      <h1>Ready to train?</h1>
    </div>
    <%= link_to new_split_path, class: "btn btn-primary" do %><i class="fa-solid fa-plus"></i> New split<% end %>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-tile"><span class="stat-value"><%= @splits_count %></span><span class="stat-label">Splits</span></div></div>
    <div class="col-md-4"><div class="stat-tile"><span class="stat-value"><%= @logs_count %></span><span class="stat-label">Workouts logged</span></div></div>
    <div class="col-md-4"><div class="stat-tile"><span class="stat-value"><%= @sets_count %></span><span class="stat-label">Sets recorded</span></div></div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card split-card is-active">
        <% if @active_split %>
          <div class="card-header">
            <div>
              <p class="eyebrow">Active split</p>
              <h2><%= link_to @active_split.name, @active_split, class: "row-title" %></h2>
            </div>
            <% if @splits_count > 1 %><%= link_to "Change", splits_path(from: "dashboard"), class: "link-quiet" %><% end %>
          </div>
          <div class="card-body">
            <%= render "splits/week", split: @active_split, workout_days: @active_days %>
          </div>
        <% else %>
          <div class="card-header"><h2>Active split</h2></div>
          <div class="empty-state">
            <i class="fa-solid fa-layer-group"></i>
            <p>You have no splits yet. A split is your training program, made of workout days.</p>
            <%= link_to "Create your first split", new_split_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card">
        <div class="card-header"><h2>Recent workouts</h2><%= link_to "History", workout_logs_path, class: "link-quiet" %></div>
        <% if @recent_logs.empty? %>
          <div class="empty-state">
            <i class="fa-solid fa-clipboard-list"></i>
            <p>No workouts logged yet. Open a workout day, open an exercise and add your first set.</p>
          </div>
        <% else %>
          <ul class="list-rows">
            <% @recent_logs.each do |log| %>
              <li>
                <div>
                  <%= link_to log.workout_day.day, workout_log_path(log), class: "row-title" %>
                  <div class="text-muted small"><%= l log.date, format: :long %> · <%= pluralize(log.workout_log_exercises.sum { |e| e.workout_sets.size }, "set") %></div>
                </div>
                <span class="chip"><%= log.workout_day.split.name %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <section class="hero">
    <span class="brand-mark brand-mark-lg"><i class="fa-solid fa-dumbbell"></i></span>
    <h1>Plan your training.<br>Record every set.</h1>
    <p>Build your own splits, choose the exercises for each day of your week, and log the reps and weight of every set you do.</p>
    <div class="hero-actions">
      <%= link_to "Create an account", new_user_registration_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Log in", new_user_session_path, class: "btn btn-light btn-lg" %>
    </div>
  </section>
<% end %>
