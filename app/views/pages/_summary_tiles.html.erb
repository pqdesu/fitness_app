<%# The figures of a WorkoutSummary: workouts, exercises, sets, the heaviest weight and the time of cardio. Local: summary. %>
<dl class="week-summary">
  <div><dt>Workouts</dt><dd><%= summary.workouts %></dd></div>
  <div><dt>Exercises</dt><dd><%= summary.exercises %></dd></div>
  <div><dt>Sets</dt><dd><%= summary.sets %></dd></div>
  <div><dt>Top weight</dt><dd><% if summary.top_weight %><% top = weight_text(summary.top_weight) %><% if top.size > 7 %><span class="is-long"><%= safe_join(top.split(/(?<=,)/), tag.wbr) %></span><% else %><span class="text-nowrap"><%= top %></span><% end %><small> kg</small><% else %>–<% end %></dd></div>
  <% if summary.cardio_seconds.positive? %><div class="week-summary-wide"><dt>Cardio</dt><dd><%# A number stays with its unit when the tile wraps ("1 h 3 min"). %><%= safe_join(duration_text(summary.cardio_seconds).scan(/\d+ \S+/).map { |part| tag.span(part, class: "text-nowrap") }, " ") %></dd></div><% end %>
</dl>
