<%# The Today page, the app's first tab: today's workout (Start workout, Continue, today's sets),
    or on a rest day the choices to move a workout to today or train one anyway, already open.
    This week's plan is below it, with "Move a workout" and "Back to the plan". %>
<% dashboard = @dashboard %>
<% split = dashboard.split %>
<div class="today-page">
  <div class="page-header">
    <div>
      <p class="eyebrow">Today</p>
      <h1><%= l dashboard.today, format: "%A, %B %-d" %></h1>
    </div>
  </div>

  <% if split %>
    <%= render "today_box", dashboard: dashboard, dated: false, open: true %>

    <div class="card">
      <div class="card-header">
        <h2>This week</h2>
        <%= link_to split.name, split, class: "link-quiet" %>
      </div>
      <div class="card-body">
        <%= render "splits/week", split: split, workout_days: dashboard.days, plan: dashboard.week_plan, today: dashboard.today.wday %>
        <%= render "week_moves", dashboard: dashboard, split: split %>
      </div>
    </div>

    <%= render "today_popups", dashboard: dashboard, split: split %>
  <% else %>
    <div class="card"><%= render "splits/empty" %></div>
  <% end %>
</div>
