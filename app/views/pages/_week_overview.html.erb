<%#
  This week at a glance, Sunday to Saturday. The summary (workouts, exercises, sets and the heaviest
  weight) is always visible; the toggle opens one row per day: what was logged, how many exercises and sets.
  A logged day links to that workout, or to the day's list in History when there were several.
  Locals: dates (the 7 days), logs_by_date (date => workout logs), summary (a WorkoutSummary of
  the week), today.
%>
<div class="week-overview">
  <h3 class="h6">This week</h3>
  <%= render "summary_tiles", summary: summary %>

  <%= render "shared/list_toggle", target: "week-days", label: "days" %>

  <div class="collapse" id="week-days">
    <ul class="week-overview-days">
      <% dates.each do |date| %>
        <% day_logs = logs_by_date.fetch(date, []) %>
        <%# A workout left with nothing in it is not one done. %>
        <% logged = day_logs.any?(&:logged?) %>
        <li class="<%= class_names("is-today": date == today, "has-workout": logged) %>">
          <span class="week-overview-name"><%= l date, format: "%a" %></span>
          <% if logged %>
            <%= link_to day_logs.map(&:workout).to_sentence, day_logs_path(day_logs, date), class: "row-title" %>
            <% day = WorkoutSummary.new(day_logs) %>
            <span class="text-muted small"><%= summary_counts(day) %></span>
          <% else %>
            <span class="text-muted"><%= date > today ? "–" : "Rest" %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
