<%#
  One recent workout as a dropdown. The summary row opens a panel with the exercises, each as a
  pill showing its heaviest set; a pill opens that exercise's sets. "Open workout" is the only
  link out. Locals: log (loaded with its exercises and sets), active_split (its chip is left out: it says nothing there).
%>
<% panel_id = "recent-log-#{log.id}" %>
<% lifts = log.workout_log_exercises.to_a %>
<% summary = WorkoutSummary.new(log) %>
<li class="recent-row">
  <button type="button" class="recent-toggle" data-bs-toggle="collapse" data-bs-target="#<%= panel_id %>"
          aria-expanded="false" aria-controls="<%= panel_id %>">
    <span class="recent-summary">
      <span class="row-title"><%= log.workout %></span>
      <span class="text-muted small"><%= short_date log.date %> · <%= lifts.empty? ? empty_log_label(log) : sets_and_time(summary.sets, summary.cardio_seconds) %></span>
    </span>
    <% if log.rest_day? || (log.workout_day && log.workout_day.split != active_split) %>
      <span class="recent-chips">
        <% if log.rest_day? %><span class="chip chip-rest">Rest day</span><% end %>
        <% if log.workout_day && log.workout_day.split != active_split %><%= split_chip log.workout_day.split, active_split %><% end %>
      </span>
    <% end %>
    <i class="fa-solid fa-chevron-down recent-chevron" aria-hidden="true"></i>
  </button>

  <div class="collapse recent-panel" id="<%= panel_id %>">
    <p class="recent-counts"><%= lifts.empty? ? empty_log_label(log) : summary_counts(summary) %></p>
    <% if (time = workout_time(log)) %><p class="recent-counts"><i class="fa-regular fa-clock" aria-hidden="true"></i> <%= time %></p><% end %>

    <% if lifts.empty? %>
      <p class="text-muted small">No exercises in this workout.</p>
    <% else %>
      <%= render "shared/list_toggle", target: "#{panel_id}-lifts", label: "exercises", css: "mb-2" %>
      <ul class="lift-pills collapse" id="<%= panel_id %>-lifts">
        <% lifts.each do |lift| %>
          <% top = lift.top_set %>
          <li>
            <% if top %>
              <% sets_id = "recent-lift-#{lift.id}" %>
              <button type="button" class="lift-pill" data-bs-toggle="collapse" data-bs-target="#<%= sets_id %>"
                      aria-expanded="false" aria-controls="<%= sets_id %>">
                <span class="lift-pill-name"><%= lift.name %></span>
                <span class="top-set"><%= weight_and_reps(top) %></span>
                <i class="fa-solid fa-chevron-down lift-pill-chevron" aria-hidden="true"></i>
              </button>
              <ol class="collapse lift-sets" id="<%= sets_id %>">
                <% lift.workout_sets.sort_by(&:set_number).each do |set| %>
                  <li>
                    <span class="text-muted">Set <%= set.set_number %></span>
                    <span><%= weight_and_reps(set) %></span>
                  </li>
                <% end %>
              </ol>
            <% elsif lift.cardio_entries.any? %>
              <%# Cardio shows its time; its rows are on the workout's page. %>
              <span class="lift-pill">
                <span class="lift-pill-name"><%= lift.name %></span>
                <span class="top-set"><%= entry_done(lift) %></span>
              </span>
            <% else %>
              <span class="lift-pill is-empty">
                <span class="lift-pill-name"><%= lift.name %></span>
                <span class="text-muted">No sets</span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if log.notes.present? %><p class="recent-notes"><%= log.notes %></p><% end %>
    <%= link_to workout_log_path(log, from: "dashboard"), class: "btn btn-light btn-sm rounded-pill recent-open" do %>Open workout <i class="fa-solid fa-arrow-right" aria-hidden="true"></i><% end %>
  </div>
</li>
