<%# Saving or deleting a set comes back here (redirect_back): Turbo morphs the page in place and keeps the scroll. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% back_to workout_log_path(@entry.workout_log_id) %>
<div class="page-header">
  <div>
    <h1><%= @entry.name %></h1>
  </div>
</div>
<%# Its sets, each corrected in place: tap the weight or the reps, or Edit in its ⋯ menu. %>
<% sets = @entry.workout_sets.includes(:set_tags).sort_by(&:set_number) %>
<% if !@entry.cardio? && sets.any? %>
  <div class="card mb-3" id="entry-sets">
    <div class="card-header"><h2 class="h6 mb-0">Sets</h2></div>
    <%= render "workout_sets/table", sets: %>
  </div>
<% end %>
<div class="card form-card">
  <div class="card-body">
    <%= form_with model: @entry, class: "inline-form" do |f| %>
      <% if @entry.errors.any? %>
        <div class="alert alert-danger"><%= errors_of(@entry) %>.</div>
      <% end %>
      <%# Cardio has no equipment, only its note. %>
      <%= render "shared/equipment_fields", f: f unless @entry.cardio? %>
      <div class="<%= "mt-3" unless @entry.cardio? %>">
        <%= f.label :notes, "Note", class: "form-label" %>
        <%= f.text_area :notes, rows: 2, placeholder: "Anything to remember about this exercise today (optional)", class: "form-control" %>
      </div>
      <div class="form-actions">
        <%= f.submit "Save", class: "btn btn-primary" %>
        <%= link_to "Cancel", workout_log_path(@entry.workout_log_id), class: "btn btn-light" %>
      </div>
    <% end %>
  </div>
</div>
