<%# Saving a set or its note comes back to this same page: Turbo morphs it in place and keeps the scroll, so it does not jump. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% back_to workout_day_path(@workout_day, date: @date) %>
<% upcoming = @date > Date.current %>
<%# Cardio is logged as incline, speed and time: no sets, equipment or rest timer (it has its own timer). %>
<% cardio = @workout_exercise.cardio? %>
<%# Before the paused-timer alert, so it asks first and each asks once (rest_alert_controller.js). %>
<%= render "workout_sets/rest_alert" if !cardio || @entry&.rest_running? %>
<%= render "workout_logs/timer_alert", log: @log, leave: false %>
<% content_for :title, @workout_exercise.name %>
<div class="page-header">
  <div>
    <h1><%= @workout_exercise.name %></h1>
    <p class="text-muted mb-0"><%= @workout_exercise.equipment_label %><% if @workout_exercise.exercise&.unilateral? %> · Unilateral<% end %></p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h2><%= logging_date_label(@date) %></h2>
        <%# "Today" says the date; any other day names its weekday, so the date goes beside it. %>
        <% unless @date == Date.current %><span class="text-muted small"><%= short_date @date %></span><% end %>
      </div>

      <% if upcoming %>
        <%# A workout later this week is planned, not done: sets are added on its day. %>
        <div class="empty-state compact"><p><%= @workout_day.day %> is on <%= l @date, format: "%A" %> this week. Add sets on that day.</p></div>
      <% elsif cardio %>
        <% if @cardio_entries.empty? %>
          <div class="empty-state compact"><p>Nothing yet <%= @date == Date.current ? "today" : "on #{l @date, format: "%A"}" %>. Add your incline, speed and time below.</p></div>
        <% else %>
          <%= render "cardio_entries/table", cardio_entries: @cardio_entries, workout_exercise: @workout_exercise, date: @date %>
        <% end %>
      <% elsif @sets.empty? %>
        <div class="empty-state compact"><p>No sets yet <%= @date == Date.current ? "today" : "on #{l @date, format: "%A"}" %>. Add your first set below.</p></div>
      <% else %>
        <%= render "workout_sets/table", sets: @sets, workout_exercise: @workout_exercise, date: @date %>
      <% end %>

      <% unless upcoming %>
        <div class="card-footer">
          <% if cardio %>
            <%= render "cardio_entries/timer", entry: @entry, planned: @workout_exercise, date: @date, back: { workout_exercise_id: @workout_exercise.id, date: @date } %>
            <%= render "cardio_entries/form", parent: @workout_exercise, last: @last_cardio, date: @date, entry: @entry %>
          <% else %>
            <% if @previous %>
              <% previous_sets = @previous.workout_sets.sort_by(&:set_number) %>
              <p class="last-time text-muted small">Last time · <%= short_date(@previous.workout_log.date) %>: <%= time_parts(previous_sets.first(6).map { |set| "#{weight_number(set.weight_used) || 'BW'}×#{set.reps_completed}" } + (previous_sets.size > 6 ? ["…"] : [])) %></p>
            <% end %>
            <%= render "workout_sets/rest_timer", entry: @entry, back: { workout_exercise_id: @workout_exercise.id, date: @date } %>
            <%= render "workout_sets/form", parent: @workout_exercise, last_set: @last_set, date: @date, first: @sets.empty?, rest_entry: @entry %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-4">
    <%# A note on this exercise for that day. It is the logged exercise's note, so it can be written
        once the exercise is being logged (its first set), and shows on the logged workout too. %>
    <% if @entry %>
      <div class="card exercise-note">
        <div class="card-header"><h2>Note</h2></div>
        <div class="card-body">
          <%= form_with model: @entry, url: workout_log_exercise_path(@entry, workout_exercise_id: @workout_exercise.id, date: @date),
                class: "inline-form" do |f| %>
            <%= f.label :notes, "Note on #{@workout_exercise.name}", class: "visually-hidden" %>
            <div class="input-group">
              <%= f.text_area :notes, rows: 2, maxlength: 500, placeholder: "Anything to remember about this exercise today",
                    class: "form-control" %>
              <button type="submit" class="btn btn-primary note-save" aria-label="Save note"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% unless cardio %>
    <%# One row, "Equipment · Dumbbell", that opens the form: the choice is rarely changed. %>
    <% equipment_open = @workout_exercise.errors.any? %>
    <div class="card">
      <div class="card-body">
        <button type="button" class="choice-summary" data-bs-toggle="collapse" data-bs-target="#equipment-form"
                aria-expanded="<%= equipment_open %>" aria-controls="equipment-form">
          <span class="form-label mb-0">Equipment</span>
          <span class="choice-current"><%= @workout_exercise.equipment_label %></span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="<%= class_names("collapse", show: equipment_open) %>" id="equipment-form">
          <%= form_with model: @workout_exercise, url: workout_exercise_path(@workout_exercise, date: @date), class: "inline-form mt-3" do |f| %>
            <%= render "shared/equipment_fields", f: f %>
            <%= f.submit "Save equipment", class: "btn btn-light w-100 mt-3", data: { turbo_submits_with: "Saving…" } %>
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
</div>
