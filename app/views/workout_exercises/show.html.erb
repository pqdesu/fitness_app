<% back_to @workout_day.day, workout_day_path(@workout_day) %>
<div class="page-header">
  <div>
    <h1><%= @workout_exercise.name %></h1>
    <p class="text-muted mb-0"><%= @workout_exercise.equipment_label %></p>
  </div>
  <div class="header-actions">
    <%= button_to "Remove", workout_exercise_path(@workout_exercise), method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Remove #{@workout_exercise.name} from #{@workout_day.day}? Workouts already logged keep it." } } %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h2>Today</h2>
        <span class="text-muted small"><%= l Date.current, format: :long %></span>
      </div>

      <% if @sets.empty? %>
        <div class="empty-state compact"><p>No sets yet today. Add your first set below.</p></div>
      <% else %>
        <%= render "workout_sets/table", sets: @sets, workout_exercise: @workout_exercise %>
      <% end %>

      <div class="card-footer">
        <%= render "workout_sets/form", parent: @workout_exercise, last_set: @last_set %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><h2>Equipment</h2></div>
      <div class="card-body">
        <%= form_with model: @workout_exercise, class: "inline-form" do |f| %>
          <%= render "shared/equipment_fields", f: f %>
          <%= f.submit "Save equipment", class: "btn btn-light w-100 mt-3" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
