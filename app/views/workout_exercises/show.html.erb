<%# Saving a set or its note comes back to this same page: Turbo morphs it in place and keeps the scroll, so it does not jump. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% back_to workout_day_path(@workout_day, date: @date) %>
<% upcoming = @date > Date.current %>
<%= render "workout_logs/timer_alert", log: @log, leave: false %>
<div class="page-header">
  <div>
    <h1><%= @workout_exercise.name %></h1>
    <p class="text-muted mb-0"><%= @workout_exercise.equipment_label %><% if @workout_exercise.exercise&.unilateral? %> · Unilateral<% end %></p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h2><%= logging_date_label(@date) %></h2>
        <span class="text-muted small"><%= l @date, format: :long %></span>
      </div>

      <% if upcoming %>
        <%# A workout later this week is planned, not done: sets are added on its day. %>
        <div class="empty-state compact"><p><%= @workout_day.day %> is on <%= l @date, format: "%A" %> this week. Add sets on that day.</p></div>
      <% elsif @sets.empty? %>
        <div class="empty-state compact"><p>No sets yet <%= @date == Date.current ? "today" : "on #{l @date, format: "%A"}" %>. Add your first set below.</p></div>
      <% else %>
        <%= render "workout_sets/table", sets: @sets, workout_exercise: @workout_exercise, date: @date %>
      <% end %>

      <% unless upcoming %>
        <div class="card-footer">
          <%= render "workout_sets/form", parent: @workout_exercise, last_set: @last_set, date: @date %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-4">
    <%# A note on this exercise for that day. It is the logged exercise's note, so it can be written
        once the exercise is being logged (its first set), and shows on the logged workout too. %>
    <% if @entry %>
      <div class="card exercise-note">
        <div class="card-header"><h2>Note</h2><span class="text-muted small"><%= logging_date_label(@date) %></span></div>
        <div class="card-body">
          <%= form_with model: @entry, url: workout_log_exercise_path(@entry, workout_exercise_id: @workout_exercise.id, date: @date),
                class: "inline-form" do |f| %>
            <%= f.label :notes, "Note on #{@workout_exercise.name}", class: "visually-hidden" %>
            <%= f.text_area :notes, rows: 2, maxlength: 500, placeholder: "Anything to remember about this exercise today",
                  class: "form-control" %>
            <%= f.submit "Save note", class: "btn btn-light w-100 mt-2" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="card">
      <div class="card-header"><h2>Equipment</h2></div>
      <div class="card-body">
        <%= form_with model: @workout_exercise, url: workout_exercise_path(@workout_exercise, date: @date), class: "inline-form" do |f| %>
          <%= render "shared/equipment_fields", f: f %>
          <%= f.submit "Save equipment", class: "btn btn-light w-100 mt-3" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
