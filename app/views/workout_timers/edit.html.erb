<%# From History: when the workout finished, as hours and minutes (seconds 0). A timer left running or paused stops there. %>
<% log = @workout_log %>
<% back_to workout_logs_path %>
<div class="page-header">
  <div>
    <h1>Edit timer</h1>
    <p class="text-muted mb-0"><%= log.workout %> · <%= short_date log.date %></p>
  </div>
</div>
<div class="card form-card">
  <div class="card-body">
    <%= form_with url: workout_log_timer_path(log), method: :patch do |f| %>
      <% if log.errors.any? %>
        <div class="alert alert-danger"><%= errors_of(log) %>.</div>
      <% end %>
      <p class="mb-3">Started at <strong><%= clock_time(log.started_at) %></strong> <%= day_badge(log.started_at) %>
        <% if log.paused_seconds.positive? %><span class="text-muted">· paused <%= duration_text(log.paused_seconds) %></span><% end %></p>
      <%= f.label :finished_at, "Finished at", class: "form-label" %>
      <%# A time after midnight is the next day. %>
      <%= f.time_field :finished_at, value: (params[:finished_at] || (log.timer_end || Time.current).strftime("%H:%M")),
            required: true, class: "form-control" %>
      <div class="form-text">Hours and minutes; the seconds are set to 0. A time earlier than the start is the next day.</div>
      <div class="form-actions">
        <%= f.submit "Save", class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
        <%= link_to "Cancel", workout_logs_path, class: "btn btn-light" %>
      </div>
    <% end %>
  </div>
</div>
