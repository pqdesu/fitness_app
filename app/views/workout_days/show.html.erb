<div class="page-header">
  <div>
    <p class="eyebrow"><%= link_to "Splits", splits_path %> / <%= link_to @workout_day.split.name, @workout_day.split %></p>
    <h1><%= @workout_day.day %></h1>
  </div>
  <div class="header-actions">
    <%= button_to workout_day_workout_logs_path(@workout_day), class: "btn btn-primary" do %><i class="fa-solid fa-play"></i> Start workout<% end %>
    <%= link_to "Edit", edit_workout_day_path(@workout_day), class: "btn btn-light" %>
    <%= button_to "Delete", workout_day_path(@workout_day), method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this day with its plan and logged workouts?" } } %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h2>Planned exercises</h2></div>
      <% if @workout_exercises.empty? %>
        <div class="empty-state compact">
          <p>Nothing planned yet. Add the first exercise below.</p>
        </div>
      <% else %>
        <div class="table-responsive">
          <table class="table app-table">
            <thead><tr><th>Exercise</th><th>Sets × reps</th><th>Target weight</th><th></th></tr></thead>
            <tbody>
              <% @workout_exercises.each do |we| %>
                <tr>
                  <td>
                    <span class="fw-semibold"><%= we.exercise.name %></span>
                    <% if we.exercise.muscle_group.present? %><span class="chip ms-1"><%= we.exercise.muscle_group %></span><% end %>
                  </td>
                  <td><%= we.sets %> × <%= we.reps %></td>
                  <td><%= format_weight(we.target_weight) %></td>
                  <td class="text-end">
                    <div class="row-actions">
                      <%= link_to "Edit", edit_workout_exercise_path(we), class: "btn btn-light btn-sm" %>
                      <%= button_to "Remove", workout_exercise_path(we), method: :delete, class: "btn btn-outline-danger btn-sm",
                            form: { data: { turbo_confirm: "Remove #{we.exercise.name}? Sets logged for it are deleted too." } } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <div class="card-footer">
        <% if @exercises.empty? %>
          <p class="text-muted mb-0">The exercise catalogue is empty. <%= link_to "Open the catalogue", exercises_path %>.</p>
        <% else %>
          <%= form_with model: [@workout_day, @workout_exercise], class: "row g-2 align-items-end inline-form" do |f| %>
            <div class="col-12 col-md-5">
              <%= f.label :exercise_id, "Exercise", class: "form-label" %>
              <%= f.collection_select :exercise_id, @exercises, :id, :name, {}, class: "form-select" %>
            </div>
            <div class="col-4 col-md-2">
              <%= f.label :sets, class: "form-label" %>
              <%= f.number_field :sets, value: 3, class: "form-control" %>
            </div>
            <div class="col-4 col-md-2">
              <%= f.label :reps, class: "form-label" %>
              <%= f.number_field :reps, value: 10, class: "form-control" %>
            </div>
            <div class="col-4 col-md-2">
              <%= f.label :target_weight, "Target kg", class: "form-label" %>
              <%= f.number_field :target_weight, step: "any", placeholder: "–", class: "form-control" %>
            </div>
            <div class="col-12 col-md-1 d-grid">
              <%= f.submit "Add", class: "btn btn-primary" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><h2>Logged workouts</h2></div>
      <% if @logs.empty? %>
        <div class="empty-state compact"><p>No workouts logged for this day yet.</p></div>
      <% else %>
        <ul class="list-rows">
          <% @logs.each do |log| %>
            <li>
              <div>
                <%= link_to l(log.date, format: :long), workout_log_path(log), class: "row-title" %>
                <div class="text-muted small"><%= pluralize(log.workout_log_exercises.sum { |e| e.workout_sets.size }, "set") %></div>
              </div>
              <%= link_to workout_log_path(log), class: "btn btn-light btn-sm", "aria-label": "Open workout" do %><i class="fa-solid fa-chevron-right"></i><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</div>
