<% back_to @workout_day.split.name, @workout_day.split %>
<div class="page-header">
  <div>
    <h1><%= @workout_day.day %></h1>
    <% if @workout_day.weekday_name %><p class="text-muted mb-0"><%= @workout_day.weekday_name %></p><% end %>
  </div>
  <div class="header-actions">
    <%= link_to "Edit", edit_workout_day_path(@workout_day), class: "btn btn-light" %>
    <%= button_to "Delete", workout_day_path(@workout_day), method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this day and its exercises? Your logged workouts are kept." } } %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>Exercises</h2>
    <% if @workout_exercises.any? %>
      <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#exercise-picker"><i class="fa-solid fa-plus"></i> Add exercise</button>
    <% end %>
  </div>
  <% if @workout_exercises.empty? %>
    <div class="empty-state">
      <i class="fa-solid fa-dumbbell"></i>
      <p>No exercises for this day yet.</p>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exercise-picker"><i class="fa-solid fa-plus"></i> Add exercise</button>
    </div>
  <% else %>
    <ul class="list-rows">
      <% @workout_exercises.each do |we| %>
        <% sets_today = @sets_today.fetch(we.id, 0) %>
        <li>
          <%= link_to workout_exercise_path(we), class: "row-link" do %>
            <span class="row-title"><%= we.name %></span>
            <span class="text-muted small"><%= we.equipment_label %><% if we.exercise&.muscle_group.present? %> · <%= we.exercise.muscle_group %><% end %></span>
          <% end %>
          <% if sets_today.positive? %><span class="chip chip-done"><%= pluralize(sets_today, "set") %></span><% end %>
          <%# Quick removal for an exercise added by mistake; it only asks first when sets were already recorded. %>
          <%= button_to workout_exercise_path(we), method: :delete, class: "btn btn-link btn-sm text-danger", "aria-label": "Remove #{we.name}", title: "Remove #{we.name}",
                form: { data: ({ turbo_confirm: "Remove #{we.name} from #{@workout_day.day}? The sets you recorded stay in your history." } if sets_today.positive?) } do %><i class="fa-solid fa-trash"></i><% end %>
          <%= link_to workout_exercise_path(we), class: "btn btn-light btn-sm", "aria-label": "Open #{we.name}" do %><i class="fa-solid fa-chevron-right"></i><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<%= render "shared/exercise_picker", url: workout_day_workout_exercises_path(@workout_day),
      exercises: @picker_exercises, taken_ids: @workout_exercises.filter_map(&:exercise_id) %>
