<%# The workout of a day: what is in it so far, then what the split plans for it and is not started yet. The plan is changed on the split page. %>
<%# Dragging, adding or removing an exercise comes back to this same page: Turbo morphs it in place and keeps the scroll. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% back_to root_path %>
<% upcoming = @date > Date.current %>
<% content_for :title, "#{@workout_day.day} · #{short_date(@date)}" %>
<div class="page-header">
  <div>
    <h1><%= @workout_day.day %></h1>
    <%# The date its sets go to (see LoggingDate): today, a day earlier this week, or one to come. %>
    <p class="text-muted mb-0"><% if @date == Date.current %>Today · <% end %><%= l @date, format: "%A, %B %-d" %></p>
  </div>
  <div class="header-actions">
    <%= link_to "Plan", split_path(@workout_day.split, anchor: "day-#{@workout_day.id}"), class: "btn btn-light" %>
  </div>
</div>

<%= render "workout_logs/timer", log: @log, start_path: (workout_day_timer_path(@workout_day, date: @date) if @date == Date.current), autostart: @autostart %>
<%= render "workout_logs/timer_alert", log: @log, leave: true %>

<%# Its exercises are part of this workout: opening one is not leaving it (workout_logs/_timer_alert). %>
<div id="day-exercises" data-stays-in-workout>
  <% if @in_workout.empty? && @to_do.empty? %>
    <div class="card">
      <div class="card-header"><h2>Exercises</h2></div>
      <div class="empty-state">
        <i class="fa-solid fa-dumbbell" aria-hidden="true"></i>
        <p>No exercises planned for <%= @workout_day.day %>.<% unless upcoming %> Add one to this workout, or plan them on the split page.<% end %></p>
        <% unless upcoming %><%= exercise_picker_button "btn-primary" %><% end %>
      </div>
    </div>
  <% else %>
    <%# The workout so far, in its order: dragged into the order the exercises were done, or back to
        "Still to do" (sortable_controller.js). The same order as the logged workout's page. A day to come has no workout yet. %>
    <% unless upcoming %>
      <div class="card">
        <div class="card-header">
          <%# What is done so far on that date: exercises with a set, and sets (the header says it once). %>
          <% done = WorkoutSummary.new(@log) if @log %>
          <h2>In this workout <% if done&.exercises&.positive? %><span class="day-counts text-muted fw-normal">· <%= summary_counts(done) %></span><% else %><span class="text-muted fw-normal">· <%= @in_workout.size %></span><% end %></h2>
          <%= exercise_picker_button "btn-primary btn-sm" %>
        </div>
        <%= tag.ul class: "list-rows day-in-workout", data: { controller: "sortable", sortable_group_value: "day" } do %>
          <% @in_workout.each do |entry, planned| %>
            <% li = { class: class_names("just-moved": flash[:moved] == entry.id),
                      data: { sortable_url: move_workout_log_exercise_path(entry, workout_day_id: @workout_day.id, date: @date) } } %>
            <% if planned %>
              <%# Dragged back to "Still to do" it leaves the workout and stays on the plan. %>
              <% li[:data].merge!(sortable_into_url: workout_log_exercise_path(entry, workout_day_id: @workout_day.id, date: @date), sortable_into_method: "delete",
                                  sortable_confirm: ("Remove #{entry.name} and its sets from this workout?" if entry.workout_sets.any?)) %>
              <%= render "planned_exercise", we: planned, entry:, li:, draggable: true, in_workout: true %>
            <% else %>
              <%# Added while training, not planned: removing one takes it out of this workout, and it is gone. It cannot go to the plan's block. %>
              <% entry_path = workout_log_path(entry.workout_log_id, anchor: "entry-#{entry.id}") %>
              <%= tag.li(**li) do %>
                <span class="drag-handle" title="Drag to reorder" aria-hidden="true"><%= icon_tag "grip-vertical" %></span>
                <%= link_to entry_path, class: "row-link" do %>
                  <span class="row-text">
                    <span class="row-title"><%= entry.name %></span>
                    <span class="text-muted small"><%= entry.equipment_label %> · Added to this workout</span>
                    <% if entry.workout_sets.any? || entry.cardio_entries.any? %><span class="chip chip-done"><%= entry_done(entry) %></span><% else %><span class="text-muted small text-nowrap"><%= entry.cardio? ? "No time yet" : "No sets" %></span><% end %>
                  </span>
                  <i class="fa-solid fa-chevron-right row-chevron" aria-hidden="true"></i>
                <% end %>
                <%= button_to workout_log_exercise_path(entry, workout_day_id: @workout_day.id, date: @date), method: :delete,
                      class: "btn btn-link btn-sm text-danger row-action", "aria-label": "Remove #{entry.name} from this workout", title: "Remove #{entry.name} from this workout",
                      form: { data: ({ turbo_confirm: "Remove #{entry.name} and its sets from this workout?" } if entry.workout_sets.any?) } do %><i class="fa-solid fa-xmark" aria-hidden="true"></i><% end %>
              <% end %>
            <% end %>
          <% end %>
          <% if @in_workout.empty? %><li class="day-hint text-muted small">Drag an exercise here, or open one and add a set.</li><% end %>
        <% end %>
      </div>
    <% end %>
    <%# The plan's exercises not started yet, in the plan's order. Dragged into the workout they join it where dropped. %>
    <div class="card">
      <div class="card-header"><h2>Still to do <span class="text-muted fw-normal">· <%= @to_do.size %></span></h2></div>
      <%= tag.ul class: "list-rows day-to-do", data: ({ controller: "sortable", sortable_group_value: "day", sortable_sort_value: false } unless upcoming) do %>
        <% @to_do.each do |we| %>
          <% li = upcoming ? {} : { data: { sortable_into_url: workout_day_workout_log_exercises_path(@workout_day, date: @date, workout_exercise_id: we.id), sortable_into_method: "post" } } %>
          <%= render "planned_exercise", we:, li:, draggable: !upcoming %>
        <% end %>
        <% if @to_do.empty? %><li class="day-hint text-muted small">Everything planned is in this workout.</li><% end %>
      <% end %>
    </div>
  <% end %>
</div>

<% unless upcoming %>
  <%= render "shared/exercise_picker", url: workout_day_workout_log_exercises_path(@workout_day, date: @date), exercises: picker_exercises,
        taken_ids: @workout_exercises.filter_map(&:exercise_id) + @in_workout.filter_map { |entry, _| entry.exercise_id } %>
<% end %>
