<%# The workout of a day: what the split plans for it, and what is added while training. The plan is changed on the split page. %>
<% back_to root_path %>
<% upcoming = @date > Date.current %>
<div class="page-header">
  <div>
    <h1><%= @workout_day.day %></h1>
    <%# The date its sets go to (see LoggingDate): today, a day earlier this week, or one to come. %>
    <p class="text-muted mb-0"><% if @date == Date.current %>Today · <% end %><%= l @date, format: "%A, %B %-d" %></p>
    <%# What is done so far in this workout on that date: exercises with a set, and sets. %>
    <% if @log && (done = WorkoutSummary.new(@log)).sets.positive? %>
      <p class="day-counts small fw-semibold mb-0"><%= pluralize(done.exercises, "exercise") %> · <%= pluralize(done.sets, "set") %></p>
    <% end %>
  </div>
  <div class="header-actions">
    <%= link_to "Plan", split_path(@workout_day.split, anchor: "day-#{@workout_day.id}"), class: "btn btn-light" %>
  </div>
</div>

<%= render "workout_logs/timer", log: @log, start_path: (workout_day_timer_path(@workout_day, date: @date) if @date == Date.current), autostart: @autostart %>
<%= render "workout_logs/timer_alert", log: @log, leave: true %>

<%# Its exercises are part of this workout: opening one is not leaving it (workout_logs/_timer_alert). %>
<div class="card" data-stays-in-workout>
  <div class="card-header">
    <h2>Exercises</h2>
    <% if !upcoming && (@workout_exercises.any? || @extra_entries.any?) %>
      <%= exercise_picker_button "btn-primary btn-sm" %>
    <% end %>
  </div>
  <% if @workout_exercises.empty? && @extra_entries.empty? %>
    <div class="empty-state">
      <i class="fa-solid fa-dumbbell"></i>
      <p>No exercises planned for <%= @workout_day.day %>.<% unless upcoming %> Add one to this workout, or plan them on the split page.<% end %></p>
      <% unless upcoming %><%= exercise_picker_button "btn-primary" %><% end %>
    </div>
  <% else %>
    <%# Open while training, and it can be folded away like the other lists of exercises. %>
    <%= render "shared/list_toggle", target: "day-exercises", label: "exercises", open: true, css: "in-card" %>
    <ul class="list-rows collapse show" id="day-exercises">
      <% @workout_exercises.each do |we| %>
        <% sets_logged = @sets_logged.fetch(we.id, 0) %>
        <li>
          <%= link_to workout_exercise_path(we, date: @date), class: "row-link" do %>
            <span class="row-title"><%= we.name %></span>
            <span class="text-muted small"><%= we.equipment_label %><% if we.exercise&.unilateral? %> · Unilateral<% end %><% if we.exercise&.muscle_group.present? %> · <%= we.exercise.muscle_group %><% end %></span>
          <% end %>
          <% if sets_logged.positive? %><span class="chip chip-done"><%= pluralize(sets_logged, "set") %></span><% end %>
          <%# An admin renames the exercise from here. The name is the exercise's own, so it changes everywhere. %>
          <% if current_user.admin? && we.exercise %>
            <%= link_to edit_exercise_path(we.exercise, workout_day_id: @workout_day.id), class: "btn btn-link btn-sm",
                  "aria-label": "Edit #{we.name}", title: "Edit #{we.name}" do %><i class="fa-solid fa-pen"></i><% end %>
          <% end %>
          <%= link_to workout_exercise_path(we, date: @date), class: "btn btn-light btn-sm", "aria-label": "Open #{we.name}" do %><i class="fa-solid fa-chevron-right"></i><% end %>
        </li>
      <% end %>
      <%# Added while training, not planned: removing one takes it out of this workout, and it is gone. %>
      <% @extra_entries.each do |entry| %>
        <% entry_path = workout_log_path(entry.workout_log_id, anchor: "entry-#{entry.id}") %>
        <li>
          <%= link_to entry_path, class: "row-link" do %>
            <span class="row-title"><%= entry.name %></span>
            <span class="text-muted small"><%= entry.equipment_label %> · Added to this workout</span>
          <% end %>
          <% if entry.workout_sets.any? %><span class="chip chip-done"><%= pluralize(entry.workout_sets.size, "set") %></span><% end %>
          <%= button_to workout_log_exercise_path(entry, workout_day_id: @workout_day.id, date: @date), method: :delete,
                class: "btn btn-link btn-sm text-danger", "aria-label": "Remove #{entry.name} from this workout", title: "Remove #{entry.name} from this workout",
                form: { data: ({ turbo_confirm: "Remove #{entry.name} and its sets from this workout?" } if entry.workout_sets.any?) } do %><i class="fa-solid fa-xmark"></i><% end %>
          <%= link_to entry_path, class: "btn btn-light btn-sm", "aria-label": "Open #{entry.name}" do %><i class="fa-solid fa-chevron-right"></i><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<% unless upcoming %>
  <%= render "shared/exercise_picker", url: workout_day_workout_log_exercises_path(@workout_day, date: @date), exercises: picker_exercises,
        taken_ids: @workout_exercises.filter_map(&:exercise_id) + @extra_entries.filter_map(&:exercise_id) %>
<% end %>
