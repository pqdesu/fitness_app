<div class="page-header">
  <div>
    <p class="eyebrow">Catalogue</p>
    <h1>Exercises</h1>
    <p class="text-muted mb-0"><%= current_user.admin? ? "The catalogue is shared by everyone. As an admin you can add, edit and delete its exercises. Exercises you keep for yourself are marked “Yours”." : "The catalogue is shared by everyone and managed by an admin. Exercises you create yourself are marked “Yours”, and only you see them." %></p>
  </div>
  <% if current_user.admin? %>
    <%= link_to new_exercise_path, class: "btn btn-primary" do %><i class="fa-solid fa-plus"></i> New exercise<% end %>
  <% end %>
</div>

<div class="card">
  <% if @exercises.empty? %>
    <div class="empty-state">
      <i class="fa-solid fa-dumbbell"></i>
      <p>The catalogue is empty.</p>
    </div>
  <% else %>
    <%# One heading per muscle group, closed at first: it opens that group's exercises. %>
    <% @exercises.group_by(&:group).each do |group, group_exercises| %>
      <% group_id = "exercises-#{group.parameterize}" %>
      <button type="button" class="group-toggle exercise-group" data-bs-toggle="collapse" data-bs-target="#<%= group_id %>"
              aria-expanded="false" aria-controls="<%= group_id %>">
        <span class="group-name"><%= group %></span>
        <span class="chip"><%= group_exercises.size %></span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
      </button>
      <div class="collapse table-responsive exercise-group-list" id="<%= group_id %>">
        <table class="table app-table">
          <thead>
            <tr><th>Name</th><th>Used in plans</th><th></th></tr>
          </thead>
          <tbody>
            <% group_exercises.each do |exercise| %>
              <tr>
                <td class="fw-semibold"><%= exercise.name %><% unless exercise.shared? %> <span class="chip ms-1">Yours</span><% end %></td>
                <td><%= @usage.fetch(exercise.id, 0) %></td>
                <td class="text-end">
                  <% if current_user.admin? || !exercise.shared? %>
                    <%= actions_menu exercise.name do %>
                      <%= menu_link "Edit", edit_exercise_path(exercise) %>
                      <%= menu_delete "Delete", exercise, confirm: "Delete #{exercise.name}?" %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <%= render "shared/pagination" %>
  <% end %>
</div>
