<div class="card form-card">
  <div class="card-body">
    <%= simple_form_for exercise do |f| %>
      <%# Opened from a workout day: saving or cancelling goes back to it. %>
      <% if @return_day %><%= hidden_field_tag :workout_day_id, @return_day.id, id: nil %><% end %>
      <%= f.input :name, placeholder: "e.g. Bench press", autofocus: true %>
      <%# Chosen from the list, as in the "Add exercises" modal; empty is listed under "Other". %>
      <div class="mb-3">
        <%= render "shared/choices", f:, field: :muscle_group, label: "Muscle group", selected: exercise.muscle_group,
              id: "exercise_muscle_group", choices: [["Other", ""], *Exercise::MUSCLE_GROUPS.map { |group| [group, group] }] %>
      </div>
      <% if exercise.new_record? %>
        <%# What its planned and logged lifts start with, set when it is created; each lift can change it. %>
        <div class="mb-3">
          <%= render "shared/equipment_fields", f:, id: "exercise" %>
          <div class="form-text">Plans and workouts of this exercise start with this equipment.</div>
        </div>
      <% end %>
      <div class="form-check mb-3">
        <%= f.check_box :unilateral, class: "form-check-input", id: "exercise_unilateral" %>
        <%= f.label :unilateral, "Unilateral: one arm or one leg at a time", class: "form-check-label", for: "exercise_unilateral" %>
      </div>
      <% if exercise.new_record? %>
        <%# Only an admin reaches this form: the exercise goes to the catalogue, or stays the admin's own. %>
        <div class="form-check mb-3">
          <%= hidden_field_tag "exercise[shared]", "0", id: nil %>
          <%= check_box_tag "exercise[shared]", "1", @shared, id: "exercise_shared", class: "form-check-input" %>
          <%= label_tag "exercise_shared", "Add to the shared catalogue", class: "form-check-label" %>
          <div class="form-text">Unticked, the exercise is only yours.</div>
        </div>
      <% end %>
      <div class="form-actions">
        <%= f.button :submit, (exercise.persisted? ? "Save exercise" : "Create exercise"), class: "btn-primary", data: { turbo_submits_with: "Saving…" } %>
        <%= link_to "Cancel", (@return_day ? workout_day_path(@return_day) : exercises_path), class: "btn btn-light" %>
      </div>
    <% end %>
  </div>
</div>
