<div class="card form-card">
  <div class="card-body">
    <%= simple_form_for exercise do |f| %>
      <%= f.input :name, placeholder: "Bench press", autofocus: true %>
      <%= f.input :muscle_group, placeholder: "Chest" %>
      <div class="form-actions">
        <%= f.button :submit, class: "btn-primary" %>
        <%= link_to "Cancel", exercises_path, class: "btn btn-light" %>
      </div>
    <% end %>
  </div>
</div>
