<%#
  The rest timer between sets, on today's workout only, once the exercise has a set: Start rest when
  a set is done, Stop before the next; the next set saves the rest (WorkoutSetsController#create).
  Locals: entry (the logged exercise), and back, the exercise page's workout_exercise_id and date,
  so it returns there.
%>
<% if entry&.workout_log&.date == Date.current && entry.workout_sets.any? %>
  <% rest_path = workout_log_exercise_rest_path(entry, **local_assigns.fetch(:back, {})) %>
  <div class="rest-timer">
    <% if entry.rest_running? %>
      <%# rest_alert_controller.js asks before leaving the page while it runs. %>
      <span class="rest-label" data-rest-running="<%= workout_log_exercise_rest_path(entry) %>">
        <i class="fa-solid fa-stopwatch" aria-hidden="true"></i> Rest
        <strong class="rest-clock" role="timer" data-controller="timer" data-timer-start-value="<%= entry.rest_started_at.iso8601 %>" data-timer-format-value="short"><%= short_clock((Time.current - entry.rest_started_at).to_i) %></strong>
      </span>
      <%= button_to rest_path, method: :patch, class: "btn btn-light", "aria-label": "Stop rest" do %><i class="fa-solid fa-stop" aria-hidden="true"></i> Stop<% end %>
    <% elsif entry.rest_ended_at %>
      <span class="rest-label"><i class="fa-solid fa-stopwatch" aria-hidden="true"></i> Rest <strong><%= duration_text((entry.rest_ended_at - entry.rest_started_at).round) %></strong></span>
      <span class="text-muted small">goes with set <%= entry.workout_sets.size + 1 %></span>
    <% else %>
      <%= button_to rest_path, class: "btn btn-light" do %><i class="fa-solid fa-stopwatch" aria-hidden="true"></i> Start rest<% end %>
    <% end %>
  </div>
<% end %>
