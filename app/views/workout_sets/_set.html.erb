<%#
  One recorded set, as a row of a set table. The pen turns its weight and reps into fields,
  so a mistake is corrected in place instead of deleting the set. Locals: set.
%>
<% form_id = "edit_set_#{set.id}" %>
<tr data-controller="row-edit" data-action="keydown.esc->row-edit#cancel">
  <td><span class="order-badge"><%= set.set_number %></span></td>
  <td>
    <span data-row-edit-target="view"><%= format_weight(set.weight_used) %></span>
    <%= number_field_tag "workout_set[weight_used]", number_with_precision(set.weight_used, precision: 2, strip_insignificant_zeros: true),
          id: "weight_set_#{set.id}", form: form_id, step: "any", min: 0, placeholder: "–", inputmode: "decimal",
          class: "form-control form-control-sm set-field", "aria-label": "Weight in kg of set #{set.set_number}",
          hidden: true, data: { row_edit_target: "field" } %>
  </td>
  <td>
    <span data-row-edit-target="view"><%= set.reps_completed %></span>
    <%= number_field_tag "workout_set[reps_completed]", set.reps_completed,
          id: "reps_set_#{set.id}", form: form_id, min: 0, required: true, inputmode: "numeric",
          class: "form-control form-control-sm set-field", "aria-label": "Reps of set #{set.set_number}",
          hidden: true, data: { row_edit_target: "field" } %>
  </td>
  <td class="text-end">
    <div class="set-actions" data-row-edit-target="view">
      <button type="button" class="btn btn-link btn-sm" data-action="row-edit#edit" aria-label="Edit set <%= set.set_number %>"><i class="fa-solid fa-pen"></i></button>
      <%= button_to workout_set_path(set), method: :delete, class: "btn btn-link btn-sm text-danger", "aria-label": "Delete set #{set.set_number}" do %><i class="fa-solid fa-trash"></i><% end %>
    </div>
    <%= form_with url: workout_set_path(set), method: :patch, id: form_id, class: "set-actions",
          html: { hidden: true }, data: { row_edit_target: "field form" } do %>
      <button type="submit" class="btn btn-primary btn-sm">Save</button>
      <button type="button" class="btn btn-light btn-sm" data-action="row-edit#cancel">Cancel</button>
    <% end %>
  </td>
</tr>
