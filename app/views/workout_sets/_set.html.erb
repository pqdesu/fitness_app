<%#
  One recorded set, as a group of rows (a tbody) of a set table. Edit (in its ⋯ menu) turns its weight and reps
  into fields, so a mistake is corrected in place instead of deleting the set. Tag and Add note in
  the ⋯ menu open the tags and the note field; ticking a tag saves, and the note saves when it is left, Enter
  is pressed or its arrow tapped. The note and the tag chips show under the numbers only when
  there are any. Locals: set, and optionally workout_exercise and date when the table is on an exercise's
  page, so saving or deleting returns there, on the same date.
%>
<% form_id = "edit_set_#{set.id}" %>
<% tags_id = "set-#{set.id}-tags" %>
<% note_id = "set-#{set.id}-note" %>
<% set_path = workout_set_path(set, workout_exercise_id: local_assigns[:workout_exercise]&.id, date: local_assigns[:date]) %>
<tbody data-controller="row-edit" data-action="keydown.esc->row-edit#cancel">
  <%# The rest before this set: measured by the rest timer, or typed in minutes ("~3 min"). %>
  <% if set.rest_seconds %>
    <tr class="set-rest-row"><td colspan="4" class="set-rest"><i class="fa-solid fa-stopwatch" aria-hidden="true"></i> Rest <%= rest_text(set) %></td></tr>
  <% end %>
  <tr>
    <td><span class="order-badge"><%= set.set_number %></span></td>
    <td>
      <%# Tapping the weight (or the reps) opens the edit there, as Edit in the ⋯ menu does. %>
      <span data-row-edit-target="view" class="set-value" role="button" tabindex="0"
            aria-label="Edit the weight of set <%= set.set_number %>: <%= format_weight(set.weight_used, bodyweight: set.bodyweight?, plain: true) %>"
            data-row-edit-focus-param="weight_set_<%= set.id %>"
            data-action="click->row-edit#edit keydown.enter->row-edit#edit:prevent keydown.space->row-edit#edit:prevent"><%= format_weight(set.weight_used, bodyweight: set.bodyweight?) %></span>
      <% if set.bodyweight? %>
        <%# Added (+) or taken off (−) the body; the ± changes the sign, which a phone's keypad cannot type. %>
        <div class="input-group input-group-sm set-field" hidden data-row-edit-target="field" data-controller="sign">
          <button type="button" class="btn btn-light sign-toggle" data-action="sign#flip" aria-label="Add or take off: change the sign">±</button>
          <%= number_field_tag "workout_set[weight_used]", weight_number(set.weight_used),
                id: "weight_set_#{set.id}", form: form_id, step: "any", placeholder: "0", inputmode: "decimal",
                class: "form-control", "aria-label": "Kilos added to or taken off the body in set #{set.set_number}",
                data: { sign_target: "input" } %>
        </div>
      <% else %>
        <%= number_field_tag "workout_set[weight_used]", weight_number(set.weight_used),
              id: "weight_set_#{set.id}", form: form_id, step: "any", min: 0, placeholder: "–", inputmode: "decimal",
              class: "form-control form-control-sm set-field", "aria-label": "Weight in kg of set #{set.set_number}",
              hidden: true, data: { row_edit_target: "field" } %>
      <% end %>
    </td>
    <td>
      <span data-row-edit-target="view" class="set-value" role="button" tabindex="0"
            aria-label="Edit the reps of set <%= set.set_number %>: <%= set.reps_completed %>"
            data-row-edit-focus-param="reps_set_<%= set.id %>"
            data-action="click->row-edit#edit keydown.enter->row-edit#edit:prevent keydown.space->row-edit#edit:prevent"><%= set.reps_completed %></span>
      <%= number_field_tag "workout_set[reps_completed]", set.reps_completed,
            id: "reps_set_#{set.id}", form: form_id, min: 0, required: true, inputmode: "numeric",
            class: "form-control form-control-sm set-field", "aria-label": "Reps of set #{set.set_number}",
            hidden: true, data: { row_edit_target: "field" } %>
    </td>
    <td class="text-end">
      <%# Edit and delete behind the ⋯ menu. Deleting asks first: a set deleted by a slip at the gym is gone. %>
      <div class="set-actions" data-row-edit-target="view">
        <%= actions_menu "set #{set.set_number}" do %>
          <li><button type="button" class="dropdown-item" data-action="row-edit#edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button></li>
          <% if set_tags.any? %>
            <li><button type="button" class="dropdown-item set-tag-toggle" data-bs-toggle="collapse" data-bs-target="#<%= tags_id %>"
                        aria-expanded="false" aria-controls="<%= tags_id %>"><i class="fa-solid fa-tag" aria-hidden="true"></i> Tag</button></li>
          <% end %>
          <li><button type="button" class="dropdown-item" data-bs-toggle="collapse" data-bs-target="#<%= note_id %>"
                      aria-expanded="false" aria-controls="<%= note_id %>"><i class="fa-solid fa-note-sticky" aria-hidden="true"></i> <%= set.notes.present? ? "Edit note" : "Add note" %></button></li>
          <%= menu_delete "Delete", set_path, aria: { label: "Delete set #{set.set_number}" },
                confirm: "Delete set #{set.set_number}? #{weight_and_reps(set, plain: true)}." %>
        <% end %>
      </div>
      <%# The fields and buttons of the edit sit in other cells and belong to this form by its id. %>
      <%= form_with url: set_path, method: :patch, id: form_id, html: { hidden: true }, data: { row_edit_target: "form" } do %><% end %>
    </td>
  </tr>
  <tr class="set-note">
    <td colspan="4">
      <%# Its tags and note show only when there are any; the fields open from the ⋯ menu. %>
      <% if set.set_tags.any? %>
        <div class="set-tags"><% set.set_tags.each do |tag| %><span class="chip chip-tag"><%= tag.name %></span><% end %></div>
      <% end %>
      <% if set.notes.present? %><p class="set-note-text"><%= set.notes %></p><% end %>
      <% if set_tags.any? %>
        <div class="collapse" id="<%= tags_id %>">
          <div class="set-tag-choices mb-2" role="group" aria-label="Tags of set <%= set.set_number %>">
            <%# The empty value lets the last tag be taken off. %>
            <%= hidden_field_tag "workout_set[set_tag_ids][]", "", form: form_id, id: nil %>
            <% set_tags.each do |tag| %>
              <%= check_box_tag "workout_set[set_tag_ids][]", tag.id, set.set_tags.include?(tag), form: form_id,
                    id: "tag_set_#{set.id}_#{tag.id}", class: "btn-check", data: { action: "change->row-edit#save" } %>
              <%= label_tag "tag_set_#{set.id}_#{tag.id}", tag.name, class: "btn btn-outline-primary btn-sm tag-pill" %>
            <% end %>
          </div>
        </div>
      <% end %>
      <%# The note saves when it is left, or with its blue arrow. %>
      <div class="collapse" id="<%= note_id %>">
        <div class="input-group input-group-sm mb-2">
          <%= text_field_tag "workout_set[notes]", set.notes, id: "notes_set_#{set.id}", form: form_id, maxlength: 200,
                placeholder: "Add a note", autocomplete: "off", class: "form-control",
                "aria-label": "Note on set #{set.set_number}", data: { action: "change->row-edit#save" } %>
          <button type="submit" form="<%= form_id %>" class="btn btn-primary note-save" aria-label="Save the note of set <%= set.set_number %>">
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </td>
  </tr>
  <%# While editing: the rest picker, Save and Cancel, on a row of their own so the number fields keep their width
      on a phone. The picker's lists open as the phone's wheel. They are sent with every save of this set (the note,
      a tag) holding the rest it has, so those keep it. A measured rest is minutes and seconds; any other is typed in
      whole minutes, "~3 min". %>
  <tr class="set-note" hidden data-row-edit-target="field">
    <td colspan="4">
      <div class="set-edit-bar">
        <% exact = set.rest_seconds && !set.rest_approx %>
        <div class="rest-picker" role="group" aria-label="Rest before set <%= set.set_number %>">
          <span class="rest-picker-label">Rest</span>
          <% if exact %>
            <% minutes, secs = set.rest_seconds.divmod(60) %>
            <%= select_tag "workout_set[rest_minutes]", options_for_select((0..[30, minutes].max).to_a, minutes), include_blank: "–",
                  id: "rest_min_set_#{set.id}", form: form_id, class: "form-select form-select-sm", "aria-label": "Minutes" %> min
            <%= select_tag "workout_set[rest_secs]", options_for_select((0..59).to_a, secs),
                  id: "rest_sec_set_#{set.id}", form: form_id, class: "form-select form-select-sm", "aria-label": "Seconds" %> s
          <% else %>
            <%= select_tag "workout_set[rest_minutes]", options_for_select((1..30).map { |m| ["~#{m}", m] }, set.rest_seconds&./(60)), include_blank: "–",
                  id: "rest_min_set_#{set.id}", form: form_id, class: "form-select form-select-sm", "aria-label": "About how many minutes" %> min
          <% end %>
        </div>
        <button type="submit" form="<%= form_id %>" class="btn btn-primary btn-sm" data-turbo-submits-with="Saving…">Save</button>
        <button type="button" class="btn btn-light btn-sm" data-action="row-edit#cancel">Cancel</button>
      </div>
    </td>
  </tr>
</tbody>
