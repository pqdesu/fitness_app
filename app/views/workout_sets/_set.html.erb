<%#
  One recorded set, as a group of rows (a tbody) of a set table. Edit (in its ⋯ menu) turns its weight and reps
  into fields, so a mistake is corrected in place instead of deleting the set. The note field is
  always there and saves when it is left or Enter is pressed. Locals: set, and optionally workout_exercise and date when the table is on an exercise's
  page, so saving or deleting returns there, on the same date.
%>
<% form_id = "edit_set_#{set.id}" %>
<% set_path = workout_set_path(set, workout_exercise_id: local_assigns[:workout_exercise]&.id, date: local_assigns[:date]) %>
<tbody data-controller="row-edit" data-action="keydown.esc->row-edit#cancel">
  <tr>
    <td><span class="order-badge"><%= set.set_number %></span></td>
    <td>
      <span data-row-edit-target="view"><%= format_weight(set.weight_used, bodyweight: set.bodyweight?) %></span>
      <% if set.bodyweight? %>
        <%# Added (+) or taken off (−) the body; the ± changes the sign, which a phone's keypad cannot type. %>
        <div class="input-group input-group-sm set-field" hidden data-row-edit-target="field" data-controller="sign">
          <button type="button" class="btn btn-outline-secondary sign-toggle" data-action="sign#flip" aria-label="Add or take off: change the sign">±</button>
          <%= number_field_tag "workout_set[weight_used]", weight_number(set.weight_used),
                id: "weight_set_#{set.id}", form: form_id, step: "any", placeholder: "0", inputmode: "decimal",
                class: "form-control", "aria-label": "Kilos added to or taken off the body in set #{set.set_number}",
                data: { sign_target: "input" } %>
        </div>
      <% else %>
        <%= number_field_tag "workout_set[weight_used]", weight_number(set.weight_used),
              id: "weight_set_#{set.id}", form: form_id, step: "any", min: 0, placeholder: "–", inputmode: "decimal",
              class: "form-control form-control-sm set-field", "aria-label": "Weight in kg of set #{set.set_number}",
              hidden: true, data: { row_edit_target: "field" } %>
      <% end %>
    </td>
    <td>
      <span data-row-edit-target="view"><%= set.reps_completed %></span>
      <%= number_field_tag "workout_set[reps_completed]", set.reps_completed,
            id: "reps_set_#{set.id}", form: form_id, min: 0, required: true, inputmode: "numeric",
            class: "form-control form-control-sm set-field", "aria-label": "Reps of set #{set.set_number}",
            hidden: true, data: { row_edit_target: "field" } %>
    </td>
    <td class="text-end">
      <%# Edit and delete behind the ⋯ menu. Deleting asks first: a set deleted by a slip at the gym is gone. %>
      <div class="set-actions" data-row-edit-target="view">
        <%= actions_menu "set #{set.set_number}" do %>
          <li><button type="button" class="dropdown-item" data-action="row-edit#edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button></li>
          <%= menu_delete "Delete", set_path, aria: { label: "Delete set #{set.set_number}" },
                confirm: "Delete set #{set.set_number}? #{weight_and_reps(set, plain: true)}." %>
        <% end %>
      </div>
      <%# The fields and buttons of the edit sit in other cells and belong to this form by its id. %>
      <%= form_with url: set_path, method: :patch, id: form_id, html: { hidden: true }, data: { row_edit_target: "form" } do %><% end %>
    </td>
  </tr>
  <tr class="set-note">
    <td colspan="4">
      <%= text_field_tag "workout_set[notes]", set.notes, id: "notes_set_#{set.id}", form: form_id, maxlength: 200,
            placeholder: "Add a note", autocomplete: "off", class: "form-control form-control-sm",
            "aria-label": "Note on set #{set.set_number}", data: { action: "change->row-edit#save" } %>
    </td>
  </tr>
  <%# While editing: Save and Cancel, on a row of their own so the number fields keep their width on a phone. %>
  <tr class="set-note" hidden data-row-edit-target="field">
    <td colspan="4">
      <div class="set-edit-bar">
        <button type="submit" form="<%= form_id %>" class="btn btn-primary btn-sm">Save</button>
        <button type="button" class="btn btn-light btn-sm" data-action="row-edit#cancel">Cancel</button>
      </div>
    </td>
  </tr>
</tbody>
