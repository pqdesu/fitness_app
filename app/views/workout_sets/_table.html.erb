<%# The recorded sets of one exercise. Locals: sets, and optionally workout_exercise and date (see workout_sets/_set). %>
<table class="table app-table set-table">
  <thead><tr><th>Set</th><th>Weight</th><th>Reps</th><th></th></tr></thead>
  <%= render partial: "workout_sets/set", collection: sets, as: :set, locals: { workout_exercise: local_assigns[:workout_exercise], date: local_assigns[:date] } %>
</table>
