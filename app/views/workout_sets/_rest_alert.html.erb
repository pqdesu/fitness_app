<%#
  The rest alert (rest_alert_controller.js), while a rest timer runs: Add set asks whether to save
  the rest until now or none, and leaving the page whether to stop the rest or go back to the page.
  Always on the page (it asks only while a rest runs), so its listeners come before the paused-timer alert's.
%>
<div class="modal fade confirm-modal" id="rest-alert-modal" tabindex="-1" aria-labelledby="rest-alert-title"
     aria-describedby="rest-alert-detail" aria-hidden="true" data-controller="rest-alert">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <span class="confirm-icon timer-alert-icon"><i class="fa-solid fa-stopwatch" aria-hidden="true"></i></span>
        <h2 class="confirm-title" id="rest-alert-title" data-rest-alert-target="title"></h2>
        <p class="confirm-detail" id="rest-alert-detail" data-rest-alert-target="detail"></p>
        <div class="confirm-actions">
          <button type="button" class="btn btn-light" data-rest-alert-target="secondary"
                  data-action="rest-alert#choose" data-rest-alert-choice-param="secondary"></button>
          <button type="button" class="btn btn-primary" data-rest-alert-target="primary"
                  data-action="rest-alert#choose" data-rest-alert-choice-param="primary"></button>
        </div>
      </div>
    </div>
  </div>
</div>
