<!DOCTYPE html>
<html lang="en">
  <head>
    <title>FitnessApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Fonts (config/_fonts.scss names them): fetched alongside the app's stylesheet, not after it. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body data-time-zone="<%= Time.zone.tzinfo.name %>" data-reloadable="<%= request.get? %>"
        data-back-skip="<%= action_name.in?(%w[new edit create update]) %>">
    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>
    <%= render "shared/confirm" %>

    <main class="container app-main">
      <% if devise_controller? %>
        <div class="auth-card card">
          <div class="card-body">
            <%= yield %>
          </div>
        </div>
      <% else %>
        <%= yield :back %>
        <%= yield %>
      <% end %>
    </main>
  </body>
</html>
